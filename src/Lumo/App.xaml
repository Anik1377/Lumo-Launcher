<Application x:Class="Lumo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- v3.0 — the WPF-UI Fluent layer. ThemesDictionary carries the light/
                     dark palettes (ThemeService keeps it synced with the active Lumo
                     theme); ControlsDictionary installs the modern implicit styles for
                     base controls app-wide — buttons, toggles, scrollbars, tooltips.
                     Lumo's own ThemeService remains the palette authority: every window
                     still paints its brush tokens from ThemeService.Paint. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
