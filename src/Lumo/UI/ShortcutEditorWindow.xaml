<Window x:Class="Lumo.UI.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumo Shortcut"
        Width="520" SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- rounded text field (Apple settings look) -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegSelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tiny round icon button for step cards (▲ ▼ ✕) -->
        <Style x:Key="StepMiniButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Margin" Value="2,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border x:Name="ShadowHost" CornerRadius="16" Margin="0,3,0,5" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.30"/>
            </Border.Effect>
            <Border Background="#33000000" CornerRadius="12" Margin="8"/>
        </Border>

        <Border x:Name="Root" CornerRadius="14" BorderThickness="1"
                BorderBrush="{DynamicResource BorderLineBrush}" Background="#FF1C1C1E"
                TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <StackPanel Margin="22,18,22,18">

                <!-- header -->
                <Grid>
                    <TextBlock x:Name="HeaderText" Text="New shortcut" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleBrush}"/>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                               Foreground="{DynamicResource SubtitleBrush}" MouseLeftButtonUp="OnCloseClick"
                               ToolTip="Close (Esc)"/>
                </Grid>

                <TextBlock x:Name="SubtitleText" Text="Run it any time by typing  /sc name  in Lumo" FontSize="11.5"
                           Foreground="{DynamicResource SubtitleBrush}" Margin="1,4,0,14"/>

                <!-- name -->
                <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>

                <!-- type -->
                <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                <Border Background="{DynamicResource SegTrackBrush}" CornerRadius="9" Padding="3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TypeUrl" Content="URL" Style="{StaticResource TypeRadio}"
                                     GroupName="SType" IsChecked="True" Checked="OnTypeChanged"/>
                        <RadioButton x:Name="TypeFile" Content="File" Style="{StaticResource TypeRadio}"
                                     GroupName="SType" Checked="OnTypeChanged"/>
                        <RadioButton x:Name="TypeFolder" Content="Folder" Style="{StaticResource TypeRadio}"
                                     GroupName="SType" Checked="OnTypeChanged"/>
                        <RadioButton x:Name="TypeMacro" Content="Macro" Style="{StaticResource TypeRadio}"
                                     GroupName="SType" Checked="OnTypeChanged"/>
                        <RadioButton x:Name="TypeSnippet" Content="Snippet" Style="{StaticResource TypeRadio}"
                                     GroupName="SType" Checked="OnTypeChanged"/>
                    </StackPanel>
                </Border>

                <!-- single target (url / file / folder) -->
                <StackPanel x:Name="TargetPanel" Margin="0,14,0,0">
                    <TextBlock x:Name="TargetLabel" Text="TARGET" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Style="{StaticResource FieldBox}" MinHeight="36"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnBrowseClick"/>
                    </Grid>
                    <TextBlock x:Name="TargetHint" Style="{StaticResource FieldHint}"
                               Text="e.g.  github.com  or  https://mail.google.com"/>
                </StackPanel>

                <!-- ================= macro visual builder (v1.5) ================= -->
                <StackPanel x:Name="MacroPanel" Margin="0,14,0,0" Visibility="Collapsed">

                    <TextBlock Text="ACTIONS" Style="{StaticResource FieldLabel}"/>

                    <!-- steps card list -->
                    <Border Background="{DynamicResource SegTrackBrush}" CornerRadius="12" Padding="7">
                        <Grid>
                            <ScrollViewer x:Name="StepsScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="StepsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CardBd" Background="{DynamicResource FieldBrush}"
                                                    CornerRadius="9" Padding="9,7" Margin="0,0,0,6" Cursor="Hand"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    MouseLeftButtonUp="OnStepCardClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="26" Height="26" CornerRadius="7"
                                                            Background="{DynamicResource SegTrackBrush}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11.5" Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SubtitleBrush}"/>
                                                        <TextBlock Text="{Binding Describe}" FontSize="12"
                                                                   Foreground="{DynamicResource TitleBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepMiniButton}" Content="&#xE74A;"
                                                                ToolTip="Move up" Click="OnStepUp"/>
                                                        <Button Style="{StaticResource StepMiniButton}" Content="&#xE74B;"
                                                                ToolTip="Move down" Click="OnStepDown"/>
                                                        <Button Style="{StaticResource StepMiniButton}" Content="&#xE74D;"
                                                                ToolTip="Remove" Click="OnStepDelete"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="StepsEmpty" Text="No actions yet — tap “Add action” below, or record steps from the launcher."
                                       FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"
                                       Margin="6,10,6,10" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- add / test row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddActionButton" Content="＋  Add action" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" Click="OnAddActionClick"/>
                        <Button Grid.Column="1" Content="▶  Test run" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="OnTestRunClick" ToolTip="Runs the macro now"/>
                    </Grid>

                    <!-- inline action editor -->
                    <Border x:Name="StepEditorPanel" Background="{DynamicResource SegTrackBrush}" CornerRadius="12"
                            Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="StepApp" Content="Open App" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" IsChecked="True" Checked="OnStepTypeChanged"/>
                                <RadioButton x:Name="StepUrl" Content="Open URL" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" Checked="OnStepTypeChanged"/>
                                <RadioButton x:Name="StepFile" Content="Open File" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" Checked="OnStepTypeChanged"/>
                                <RadioButton x:Name="StepFolder" Content="Open Folder" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" Checked="OnStepTypeChanged"/>
                                <RadioButton x:Name="StepWait" Content="Wait" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" Checked="OnStepTypeChanged"/>
                                <RadioButton x:Name="StepClip" Content="Clipboard" Style="{StaticResource TypeRadio}"
                                             GroupName="StepType" Checked="OnStepTypeChanged"/>
                            </WrapPanel>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="StepArgBox" Style="{StaticResource FieldBox}" MinHeight="34" FontSize="12.5"/>
                                <Button x:Name="StepBrowseButton" Grid.Column="1" Content="Browse…"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnStepBrowseClick"/>
                            </Grid>

                            <TextBlock x:Name="StepArgHint" Style="{StaticResource FieldHint}"
                                       Text="Path to the program, document or shortcut (.lnk). %ENV% supported."/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="CancelEditButton" Content="Cancel" Style="{StaticResource GhostButton}"
                                        Visibility="Collapsed" Click="OnCancelEditClick"/>
                                <Button x:Name="AddStepButton" Content="Add step" Style="{StaticResource AccentButton}"
                                        Margin="8,0,0,0" Click="OnAddStepConfirmClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- keywords -->
                <TextBlock Text="KEYWORDS (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
                <TextBox x:Name="KeywordsBox" Style="{StaticResource FieldBox}"/>
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Extra words that should find this shortcut, comma separated."/>

                <!-- validation + buttons -->
                <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#FF6A6A" Margin="2,10,0,0"
                           Visibility="Collapsed" TextWrapping="Wrap"/>
                <TextBlock x:Name="RunInfoText" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"
                           Margin="2,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelClick"/>
                    <Button Content="Save shortcut" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                            Click="OnSaveClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
