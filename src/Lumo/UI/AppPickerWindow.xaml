<Window x:Class="Lumo.UI.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an app"
        Width="640" Height="560"
        MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        v3.0.0-alpha.6 — the App Deck app picker. Clicking an empty slot (or
        "Pick app…" in the slot editor) opens THIS window instead of a raw
        Explorer dialog: every Start Menu + Desktop shortcut on the PC, live
        fuzzy search, real icons, Enter or double-click to assign. The old
        file dialog stays one click away ("Browse for a file…") for anything
        that isn't a Start Menu app — scripts, folders, documents.
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PickerCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" TextOptions.TextRenderingMode="ClearType"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PickerCloseButton" TargetType="Button" BasedOn="{StaticResource PickerCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" TextOptions.TextRenderingMode="ClearType"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PickerSearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PickerGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" CornerRadius="8"
            Background="{DynamicResource PanelBrush}"
            TextElement.FontFamily="/Assets/Fonts/#Inter"
            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ caption band ============ -->
            <Border Grid.Row="0" x:Name="CaptionBar" Background="{DynamicResource CaptionBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="OnDragWindow">
                <Grid Height="46" Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7"
                                Background="{DynamicResource GlyphBoxBrush}" IsHitTestVisible="False">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Choose an app" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CaptionSlot" Text="" FontSize="11" Margin="10,1.5,0,0"
                                   Foreground="{DynamicResource SubtitleBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{StaticResource PickerCloseButton}"
                            HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCancel" ToolTip="Cancel (esc)"/>
                </Grid>
            </Border>

            <!-- ============ search + count ============ -->
            <StackPanel Grid.Row="1" Margin="18,14,18,8">
                <Grid>
                    <TextBox x:Name="PickerSearch" Style="{StaticResource PickerSearchBox}"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search every app on this PC…"
                               FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtitleBrush}" Opacity="0.55"
                               IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="PickerCount" Text="Looking for installed apps…" FontSize="11"
                           Margin="2,7,0,0" Foreground="{DynamicResource SubtitleBrush}"/>
            </StackPanel>

            <!-- ============ results ============ -->
            <Grid Grid.Row="2" Margin="18,0,18,0">
                <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="OnListDoubleClick" MouseLeftButtonUp="OnListClick"
                         SelectionChanged="OnListSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                                       Source="{Binding IconImage}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TitleBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="10.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource SubtitleBrush}" Opacity="0.8"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource AccentBrush}" Opacity="0.55"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="10,7,10,7" Margin="0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="PickerEmpty" Text="" FontSize="12.5" Margin="4,24,4,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SubtitleBrush}" Visibility="Collapsed"/>
            </Grid>

            <!-- ============ footer ============ -->
            <Grid Grid.Row="3" Margin="18,8,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtitleBrush}" Opacity="0.85"
                           Text="Type to search · ↑↓ to move · Enter or double-click to assign · Esc to cancel"/>
                <Button x:Name="PickerBrowse" Grid.Column="1" Style="{StaticResource PickerGhostButton}"
                        Content="Browse for a file…" Click="OnBrowse" Margin="12,0,0,0"
                        ToolTip="Pick an exe, shortcut, script or document with the classic file dialog"/>
            </Grid>
        </Grid>
    </Border>
</Window>
