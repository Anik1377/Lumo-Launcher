<Window x:Class="Lumo.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Lumo"
        Width="600" SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- prefix pill chip (step 2) -->
        <Style x:Key="PrefixChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Root" Background="#151519" CornerRadius="14" BorderThickness="1"
                BorderBrush="#2A2A30" Padding="34,26,34,22">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" CenterX="300" CenterY="200"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- dots -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}"/>
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource BorderLineBrush}"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{DynamicResource BorderLineBrush}"/>
                </StackPanel>

                <!-- ================= step panels ================= -->
                <Grid Grid.Row="1" MinHeight="290">

                    <!-- STEP 1 — meet Lumo -->
                    <StackPanel x:Name="Step0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="One hotkey for everything" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>
                        <TextBlock FontSize="13" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" Margin="0,10,0,0"
                                   Text="Lumo finds apps, files, calculations, bookmarks and the web before your mouse reaches a menu — a fast, portable launcher that stays out of the way until you call it."/>
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="9" Padding="14,9"
                                HorizontalAlignment="Center" Margin="0,18,0,0"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Press" FontSize="13" Foreground="{DynamicResource SubtitleBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="9,3" Margin="8,0">
                                    <TextBlock x:Name="HotkeyChip" Text="Alt+Space" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleBrush}"/>
                                </Border>
                                <TextBlock Text="anywhere, anytime" FontSize="13" Foreground="{DynamicResource SubtitleBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- STEP 2 — the prefixes -->
                    <StackPanel x:Name="Step1" Orientation="Vertical" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Type a prefix, get a superpower" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" Margin="0,8,0,14"
                                   Text="Just typing searches apps and files. Prefixes go deeper — try C/12*7 or W/weather right away."/>
                        <WrapPanel HorizontalAlignment="Center" MaxWidth="470" Margin="0,2,0,0">
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="A/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  apps" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="F/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  files" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="C/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  calculator" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="W/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  web" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="B/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  bookmarks" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="U/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  utilities" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="/sc" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  shortcuts &amp; macros" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  snippets" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="?" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  ask AI" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource PrefixChip}"><StackPanel Orientation="Horizontal"><TextBlock Text="P/" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  plugins" Foreground="{DynamicResource TitleBrush}"/></StackPanel></Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- STEP 3 — data & updates -->
                    <StackPanel x:Name="Step2" Orientation="Vertical" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Yours, and up to date" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="450" Margin="0,10,0,0"
                                   Text="Everything you build — shortcuts, snippets, chats, plugins — stays on this PC. Lumo quietly watches GitHub for new releases and tells you when one lands; installing is always your call."/>
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="16,12" Margin="0,18,0,0"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="DataLine" FontSize="12" Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap"
                                           Text="Data folder:"/>
                                <TextBlock x:Name="DataSubLine" FontSize="11" Foreground="{DynamicResource SubtitleBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}" HorizontalAlignment="Center"
                                   Margin="0,14,0,0" Text="Replay this tour anytime: Settings → About → Replay intro tour"/>
                    </StackPanel>
                </Grid>

                <!-- ================= footer ================= -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="Back" Style="{StaticResource GhostButton}"
                            IsEnabled="False" Click="OnBack"/>
                    <Button x:Name="NextButton" Grid.Column="2" Content="Next" Style="{StaticResource AccentButton}"
                            MinWidth="110" Click="OnNext"/>
                    <Button x:Name="SkipButton" Grid.Column="3" Content="Skip" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" Click="OnSkip"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
