<Window x:Class="Lumo.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Lumo.UI"
        Title="Lumo Settings"
        Width="1200" Height="800"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        v2.4 — Raycast-grade settings shell on the shared surface ladder:
        canvas #0E0F12, elevated cards #14151A with hairline strokes, quiet
        neutral nav pills, Inter typography throughout. Same tokens as the
        launcher and the AI chat — one design system, three surfaces.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 toggle switch (40×20, rounded track, accent when on) -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource SegTrackBrush}" BorderThickness="0"/>
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource TitleBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Setter TargetName="Dot" Property="Margin" Value="24,0,0,0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Margin"
                                                                To="24,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Margin"
                                                                To="4,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 nav item — v2.4: quiet Raycast pill (6 px radius), accent bar only when selected -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch" Margin="-7,2,0,2"
                                           Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                           Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented-control segment (macOS style: joint track, elevated selection) -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="14,5.5">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegSelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- option pill (border styles) — Win11 buttons are rectangles with 4 px corners -->
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" Padding="14,6.5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- buttons -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.4 — page title (Inter SemiBold, sentence case) -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Margin" Value="2,0,0,14"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- v2.4 — WinUI caption buttons: full-bleed quiet hover, WinUI-red close.
               The stock WPF button chrome (classic blue hover square) screamed "cheap". -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- v2.4 — full-bleed window: no outer glow frame, no margin -->
    <Grid>
        <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Background="#FF0E0F12"
                TextElement.FontFamily="/Assets/Fonts/#Inter"
                BorderBrush="{DynamicResource BorderLineBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ title bar (Win11: 44 px, quiet, caption buttons right) ============ -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragWindow" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lumo" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" FontSize="14"
                                   Foreground="{DynamicResource TitleBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="10" Margin="12,0,0,0" Padding="8,2.5"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                            <TextBlock Text="ALPHA · UNSTABLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="5" Margin="8,0,0,0" Padding="8,2.5">
                            <TextBlock x:Name="VersionText" Text="v2.0" FontSize="10.5"
                                       Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinButton" Width="46" Height="34" Click="OnMinimize"
                                Style="{StaticResource CaptionButton}"
                                Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        <Button x:Name="CloseButton" Width="46" Height="34" Click="OnClose"
                                Style="{StaticResource CloseCaptionButton}"
                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- ============ body ============ -->
                <Grid Grid.Row="1" Margin="24,8,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- sidebar (quiet Raycast nav: monochrome glyphs on soft pills) -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="8"
                            Padding="0,10" Margin="0,0,18,0">
                        <StackPanel>
                            <RadioButton x:Name="NavGeneral" Tag="0" IsChecked="True" Checked="OnNavChanged"
                                         Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="General" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="1" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="2" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Hotkey" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="3" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Search &amp; Index" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="4" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Shortcuts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="7" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Plugins" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="6" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="AI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="5" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="About" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- panels -->
                    <Grid Grid.Column="1">

                        <!-- ================= GENERAL ================= -->
                        <ScrollViewer x:Name="PanelGeneral" behaviors:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start Lumo when Windows starts" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Adds Lumo to the per-user Run key — no admin rights needed. Applied when you press Save."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hide launcher when it loses focus" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Click anywhere else and the launcher tucks itself away."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="HideOnFocusLossToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Web search engine" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Used by W/ queries and the “search the web” row."/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                    Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="EngineGoogle" Content="Google" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                    <RadioButton x:Name="EngineBing" Content="Bing" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                    <RadioButton x:Name="EngineDdg" Content="DuckDuckGo" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- v3.0 — App Deck · v3.0.0-alpha.5 — the deck is its own window -->
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="App Deck" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                           Text="Nine quick-launch slots bound to numpad 1–9, living in their own window — open it below or from the deck button in the AI page's rail, then click a card (or drop a file on it) to assign an app or game."/>
                                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                    <Button x:Name="OpenDeckButton" Content="Open App Deck"
                                                            Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                            Click="OnOpenDeck"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <TextBlock Text="Global hotkeys" FontSize="11"
                                                           Foreground="{DynamicResource SubtitleBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <ToggleButton x:Name="DeckGlobalHotkeysToggle" Style="{StaticResource Switch}"
                                                              ToolTip="Register numpad 1–9 as system-wide hotkeys so the deck launches from anywhere. Off by default: inside full-screen games the numpad belongs to the game."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= APPEARANCE ================= -->
                        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      behaviors:SmoothScroll.Enabled="True">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>

                                <!-- v3.0 — the theme gallery: built-in presets + imported themes,
                                     each a live miniature of the palette. Import/export below. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Themes" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="One click applies live. Import a .json theme file to add your own — or export the current look and share it."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button x:Name="ImportThemeButton" Content="Import…" Style="{StaticResource GhostButton}" Click="OnImportTheme"/>
                                                <Button x:Name="ExportThemeButton" Content="Export…" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnExportTheme"/>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel x:Name="ThemeGallery" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="ThemeStatus" Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtitleBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Theme mode" Style="{StaticResource SettingName}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <Border Grid.Column="2" Background="{DynamicResource SegTrackBrush}" CornerRadius="9" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                    <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                    <RadioButton x:Name="ThemeAuto" Content="Auto" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,7,0,0"
                                                   Text="Fallback for the stock Lumo look when no gallery theme is selected — Auto follows the Windows colour mode and switches live."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="UI animations" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Window spring-in, cascading results, hover transitions. Turn off for a reduced-motion, snappier feel."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Edge shine" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="The v3 glow — a minimal 1 px light catch along the launcher's top edge, settling into the hairline. Nothing orbits, nothing pulses."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="BorderEffectToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid>
                                                    <TextBlock Text="Launcher width" Style="{StaticResource SettingName}"/>
                                                    <TextBlock x:Name="WidthValue" Text="720 px" HorizontalAlignment="Right"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                                <Slider x:Name="WidthSlider" Minimum="560" Maximum="900" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" Margin="0,8,14,0"
                                                        Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                <TextBlock Text="Corner radius" Style="{StaticResource SettingName}"/>
                                                <Border Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                        Padding="3" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="CornerRounded" Content="Win11 rounded" Style="{StaticResource SegRadio}" GroupName="Corner"/>
                                                        <RadioButton x:Name="CornerSquare" Content="Square" Style="{StaticResource SegRadio}" GroupName="Corner"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Result density" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="Compact tightens the result rows so more fit on screen."/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                    Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="DensityComfortable" Content="Comfortable" Style="{StaticResource SegRadio}" GroupName="Density"/>
                                                    <RadioButton x:Name="DensityCompact" Content="Compact" Style="{StaticResource SegRadio}" GroupName="Density"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- live preview strip -->
                                        <Border Margin="0,16,0,0" CornerRadius="12" BorderThickness="1.4" Height="64"
                                                x:Name="PreviewCard" Background="{DynamicResource FieldBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="L" FontWeight="Bold" FontSize="16" Margin="16,0,10,0"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Type to search apps, files, the web…"
                                                           FontSize="13" Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="live preview" FontSize="10.5" Margin="0,0,14,0"
                                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Accent colour" Style="{StaticResource SettingName}"/>
                                        <WrapPanel x:Name="AccentRow" Margin="0,10,0,4"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Custom hex:" Style="{StaticResource SettingDesc}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="AccentHexBox" Grid.Column="1" FontSize="12.5" Padding="8,6"
                                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                     BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                                     KeyDown="OnAccentHexKeyDown" LostFocus="OnAccentHexLostFocus"/>
                                            <TextBlock Grid.Column="2" Text="press Enter to apply" Style="{StaticResource SettingDesc}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= HOTKEY ================= -->
                        <ScrollViewer x:Name="PanelHotkey" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Hotkey" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Open / hide Lumo" Style="{StaticResource SettingName}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Click the box below, then press the combination you want. Requires Ctrl, Alt or Win so normal typing isn't hijacked."/>

                                        <Border x:Name="HotkeyCapture" Margin="0,12,0,0" CornerRadius="9" Padding="14,12"
                                                Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                                                BorderThickness="1" Cursor="Hand" Focusable="True"
                                                PreviewKeyDown="OnHotkeyCaptureKeyDown" MouseLeftButtonDown="OnHotkeyCaptureClick">
                                            <TextBlock x:Name="HotkeyDisplay" Text="—" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleBrush}"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Apply hotkey" Style="{StaticResource AccentButton}" Click="OnApplyHotkey"/>
                                            <Button Content="Reset to default (Alt+Space)" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnResetHotkey"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HotkeyStatus" Margin="0,10,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                   Text="Currently active hotkey is shown in the launcher status bar."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Why can't I use Win+Space?" Style="{StaticResource SettingName}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Win+Space is reserved by Windows itself for switching keyboard layouts — no application can register it. This was the cause of the v1.0 'hotkey never works' report. Pick any other combination, e.g. Alt+Space, Ctrl+Alt+Space or Win+Q. If a combo is already taken by another app, Lumo automatically walks a fallback chain and tells you which one actually registered."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= SEARCH & INDEX ================= -->
                        <ScrollViewer x:Name="PanelSearch" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Search &amp; Index" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Maximum indexed files" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="Upper bound of the background file index. A smaller index builds faster; a larger one finds more. Applied on the next rebuild."/>
                                            </StackPanel>
                                            <TextBlock x:Name="MaxFilesLabel" Grid.Column="1" Text="150,000" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="MaxFilesSlider" Minimum="10000" Maximum="300000" TickFrequency="10000"
                                                IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <Button Content="Rebuild index now" Style="{StaticResource GhostButton}" Margin="0,12,0,0" Click="OnRebuildIndex"/>
                                        <TextBlock x:Name="IndexStatus" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" Style="{StaticResource SettingName}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Open log folder" Style="{StaticResource GhostButton}" Click="OnOpenLog"/>
                                            <Button Content="Open settings folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenSettingsFolder"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LogPathText" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource SubtitleBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= SHORTCUTS (v1.4) ================= -->
                        <ScrollViewer x:Name="PanelShortcuts" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Shortcuts &amp; Macros" Style="{StaticResource SectionTitle}"/>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Your one-tap launches" Style="{StaticResource SettingName}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                       Text="Save a URL, file, folder, a multi-step macro or a text snippet — then type  /sc name  (or  !name  for snippets) in Lumo (or just  /  to browse)."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="RecordMacroButton" Content="⏺ Record macro" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" Click="OnRecordMacro"
                                                    ToolTip="Capture what you launch in Lumo as macro steps"/>
                                            <Button Content="＋ New shortcut" Style="{StaticResource AccentButton}"
                                                    VerticalAlignment="Center" Click="OnNewShortcut"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SAVED SHORTCUTS" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource SubtitleBrush}"/>
                                        <ItemsControl x:Name="ShortcutsList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                           Margin="0,1,8,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DescribeText}" FontSize="11.5" Margin="19,2,0,0"
                                                                       Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit" Style="{StaticResource GhostButton}" Padding="12,6"
                                                                    Click="OnEditShortcut"/>
                                                            <Button Content="Delete" Style="{StaticResource GhostButton}" Padding="12,6"
                                                                    Margin="8,0,0,0" Click="OnDeleteShortcut"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ShortcutsEmpty" Text="No shortcuts yet — create your first one above. A good start: a URL you open every day."
                                                   FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= PLUGINS (v2.5, DEV_PLAN Task 4.2) ================= -->
                        <ScrollViewer x:Name="PanelPlugins" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Plugins" Style="{StaticResource SectionTitle}"/>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Declarative JSON commands" Style="{StaticResource SettingName}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                       Text="One folder per plugin, each with a plugin.json that defines keyword commands — open a URL, open a path or copy text. No code, no installs, nothing leaves your PC."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Copy starter plugin.json" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" Click="OnCopyStarterPlugin"/>
                                            <Button Content="&#x21BB; Rescan" Style="{StaticResource AccentButton}"
                                                    VerticalAlignment="Center" Click="OnRescanPlugins"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- v2.6.0-alpha.2 — first-party catalog: browse + one-click install -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FIRST-PARTY PLUGINS" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SubtitleBrush}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                           Text="Ready-made keyword sets maintained in the Lumo repo. Install downloads the manifest and activates its keywords immediately — no restart."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="FirstPartyBrowse" Content="Browse catalog" Style="{StaticResource AccentButton}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" Click="OnBrowseFirstParty"/>
                                                <Button Content="Copy AI prompt" Style="{StaticResource GhostButton}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" Click="OnCopyAiPrompt"
                                                        ToolTip="Copy a ready-to-paste prompt that makes any AI assistant write a valid plugin.json"/>
                                                <Button Content="Guide &#x2197;" Style="{StaticResource GhostButton}"
                                                        VerticalAlignment="Center" Click="OnOpenPluginDocs"
                                                        ToolTip="Open the plugin development guide on GitHub"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="FirstPartyStatus" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtitleBrush}" Visibility="Collapsed"/>

                                        <ItemsControl x:Name="FirstPartyList" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                           Margin="0,1,8,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Meta}" FontSize="11" Margin="8,1,0,0"
                                                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="19,2,12,0"
                                                                       Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ButtonText}" Style="{StaticResource GhostButton}"
                                                                Padding="12,6" VerticalAlignment="Center" MinWidth="78"
                                                                Click="OnInstallFirstParty" IsEnabled="{Binding Installable}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="INSTALLED PLUGINS" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtitleBrush}"/>
                                            <Button Grid.Column="1" Content="Open plugins folder" Style="{StaticResource GhostButton}"
                                                    Padding="12,6" Click="OnOpenPluginsFolder"/>
                                        </Grid>

                                        <ItemsControl x:Name="PluginsList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                           Margin="0,1,8,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Meta}" FontSize="11" Margin="8,1,0,0"
                                                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Commands}" FontSize="11.5" Margin="19,2,0,0"
                                                                       Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Enabled" FontSize="11.5" Margin="0,1,8,0"
                                                                       Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="OnPluginToggle" Unchecked="OnPluginToggle"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="PluginsEmpty" Text="No plugins yet — press “Copy starter plugin.json”, create a folder in the plugins dir, paste it as plugin.json, then Rescan. Or type P/ in Lumo."
                                                   FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PluginActionStatus" FontSize="11.5" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PluginsFolderText" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= AI (v2.3, DEV_PLAN Task 3.1) ================= -->
                        <ScrollViewer x:Name="PanelAI" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="AI" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Enable AI answers (? prefix)" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Type ? then a question — the answer appears in the result list; Enter copies it."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="AiEnabledToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <TextBlock Text="Provider" Style="{StaticResource SettingName}"/>
                                        <Border Background="{DynamicResource SegTrackBrush}" CornerRadius="9" Padding="3"
                                                HorizontalAlignment="Left" Margin="0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="AiOllama" Content="Ollama (local)" Style="{StaticResource SegRadio}" GroupName="AiProvider"/>
                                                <RadioButton x:Name="AiAnthropic" Content="Anthropic API" Style="{StaticResource SegRadio}" GroupName="AiProvider"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Endpoint" Style="{StaticResource SettingDesc}" Margin="0,6,0,2"/>
                                        <TextBox x:Name="AiEndpointBox" FontSize="12.5" Padding="8,6"
                                                 Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                 BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                                        <TextBlock Text="Model" Style="{StaticResource SettingDesc}" Margin="0,10,0,2"/>
                                        <TextBox x:Name="AiModelBox" FontSize="12.5" Padding="8,6"
                                                 Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                 BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                                        <TextBlock Text="API key (Anthropic only)" Style="{StaticResource SettingDesc}" Margin="0,10,0,2"/>
                                        <TextBox x:Name="AiKeyBox" FontSize="12.5" Padding="8,6"
                                                 Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                 BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="The key is stored only in settings.json on this PC and is never written to the log. Ollama needs no key — just have Ollama running locally."/>
                                    </StackPanel>
                                </Border>

                                <!-- ============ Voice input — v2.6.0-alpha.3 ============ -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Voice input in the AI chat" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Text="Dictate into the prompt with the mic button (or Ctrl+M) — offline Windows speech, nothing leaves the PC."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="VoiceEnabledToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="VoiceStatusText" Style="{StaticResource SettingDesc}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ============ Custom personas — v2.4.0-alpha.6 ============ -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Custom personas" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Text="Your own system prompts for the AI chat — pick them from the persona chip next to the model name. Stored locally in personas.json."/>
                                            </StackPanel>
                                            <Button x:Name="PersonaNewButton" Grid.Column="1" Content="New persona"
                                                    Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Top"
                                                    Click="OnPersonaNew"/>
                                        </Grid>

                                        <!-- inline editor (new + edit share it) -->
                                        <StackPanel x:Name="PersonaEditor" Margin="0,12,0,0" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Name" Style="{StaticResource SettingDesc}" Margin="0,0,0,2"/>
                                                    <TextBox x:Name="PersonaNameBox" FontSize="12.5" Padding="8,6" MaxLength="40"
                                                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                             BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- v3.0 — persona face + color: the character that
                                                 represents this persona in the chat, plus its tint -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Face" Style="{StaticResource SettingDesc}" Margin="0,0,0,4"/>
                                                    <WrapPanel x:Name="PersonaFacePicker"/>
                                                    <TextBlock Text="Color" Style="{StaticResource SettingDesc}" Margin="0,10,0,4"/>
                                                    <WrapPanel x:Name="PersonaColorPicker"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock Text="Preview" Style="{StaticResource SettingDesc}" Margin="0,0,0,4"/>
                                                    <Border Width="76" Height="76" CornerRadius="18"
                                                            Background="{DynamicResource FieldBrush}"
                                                            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                                                        <behaviors:PersonaFaceView x:Name="PersonaFacePreview" Width="54" Height="54"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="System prompt" Style="{StaticResource SettingDesc}" Margin="0,10,0,2"/>
                                            <TextBox x:Name="PersonaPromptBox" FontSize="12.5" Padding="8,6" AcceptsReturn="True"
                                                     TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" MaxLength="4000"
                                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                     BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="This prompt silently leads every reply in chats that use the persona — tone, format, focus."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="Save persona" Style="{StaticResource AccentButton}" Click="OnPersonaSave"/>
                                                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnPersonaCancel"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ItemsControl x:Name="PersonaList" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="PersonaEmpty" Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="No custom personas yet — the six built-ins are always available in the chat's persona chip."/>                                    </StackPanel>
                                </Border>

                                <!-- ============ Local models (Ollama) — v2.3.0-alpha.2 ============ -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Local models (Ollama)" Style="{StaticResource SettingName}"/>
                                                <TextBlock x:Name="OllamaStatusText" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                                                           Text="Checking…" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="OllamaRefreshButton" Grid.Column="1" Content="Refresh"
                                                    Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Top"
                                                    Click="OnOllamaRefresh"/>
                                        </Grid>

                                        <!-- Ollama missing → the one-click installer -->
                                        <StackPanel x:Name="OllamaInstallBlock" Margin="0,12,0,0">
                                            <Button x:Name="OllamaInstallButton" Content="Download &amp; install Ollama"
                                                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                    Click="OnOllamaInstall"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="Downloads the official installer from ollama.com and runs it silently — free, private, no API key, nothing leaves your PC. Windows may show a permission prompt (UAC)."/>
                                        </StackPanel>

                                        <!-- installed but not serving -->
                                        <StackPanel x:Name="OllamaStartBlock" Margin="0,12,0,0" Visibility="Collapsed">
                                            <Button x:Name="OllamaStartButton" Content="Start Ollama"
                                                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                    Click="OnOllamaStart"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="Ollama is installed but not answering on its local port — start it, then pull a model below."/>
                                        </StackPanel>

                                        <!-- ============ v3.0.0-alpha.5 — where Ollama itself lives ============ -->
                                        <Border Margin="0,14,0,0" Padding="13,11" CornerRadius="10"
                                                Background="{DynamicResource FieldBrush}"
                                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Install location" Style="{StaticResource SettingName}"/>
                                                <TextBlock x:Name="OllamaExePathText" FontSize="11.5" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                           Text="Searching the standard locations…"/>
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="OllamaInstallDirBrowse" Grid.Column="0" Content="Choose install folder…"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                            Padding="12,6" Click="OnOllamaInstallDirBrowse"
                                                            ToolTip="Where the one-click installer puts Ollama (and where Lumo looks for ollama.exe)"/>
                                                    <Button x:Name="OllamaInstallDirSave" Grid.Column="1" Content="Save location"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,6"
                                                            Click="OnOllamaInstallDirSave" Visibility="Collapsed"/>
                                                    <Button x:Name="OllamaInstallDirReset" Grid.Column="2" Content="Reset to default"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,6"
                                                            Click="OnOllamaInstallDirReset"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Text="Applies to the one-click install above (it passes /DIR to the official installer) and to where Lumo looks for ollama.exe. Standard locations: %LOCALAPPDATA%\Programs\Ollama and Program Files\Ollama."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ============ v3.0.0-alpha.5 — where the models live ============ -->
                                        <Border x:Name="OllamaStorageBlock" Margin="0,10,0,0" Padding="13,11" CornerRadius="10"
                                                Background="{DynamicResource FieldBrush}"
                                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Model storage" Style="{StaticResource SettingName}"/>
                                                <TextBlock x:Name="OllamaModelsPathText" FontSize="11.5" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                    <Button x:Name="OllamaModelsMoveButton" Content="Change folder…"
                                                            Style="{StaticResource GhostButton}" Padding="12,6" Click="OnOllamaModelsDirChange"
                                                            ToolTip="Point Ollama at another folder for model downloads (sets OLLAMA_MODELS and restarts Ollama)"/>
                                                    <Button x:Name="OllamaModelsOpenButton" Content="Open folder"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,6"
                                                            Click="OnOllamaOpenModelsFolder"/>
                                                    <Button x:Name="OllamaRestartButton" Content="Restart Ollama"
                                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,6"
                                                            Click="OnOllamaRestart"
                                                            ToolTip="Stop and start the local server — needed after OLLAMA_MODELS was changed outside Lumo"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Text="Downloads and uninstalls below act on this folder. Moving the folder points new downloads elsewhere — models already downloaded stay in the old location, move them with File Explorer if you want to keep them."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- shared progress line (download bytes or pull percent) -->
                                        <ProgressBar x:Name="OllamaProgress" Height="5" Minimum="0" Maximum="100"
                                                     Visibility="Collapsed" Margin="0,12,0,4"
                                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource AccentBrush}"
                                                     BorderThickness="0"/>
                                        <TextBlock x:Name="OllamaProgressText" FontSize="11.5" Visibility="Collapsed"
                                                   Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"/>

                                        <!-- installed models -->
                                        <TextBlock x:Name="OllamaInstalledTitle" Text="Installed models"
                                                   Style="{StaticResource SettingDesc}" Margin="0,12,0,4" Visibility="Collapsed"/>
                                        <ItemsControl x:Name="OllamaInstalledList" Visibility="Collapsed"/>

                                        <!-- curated lightweight catalog -->
                                        <TextBlock Text="Recommended lightweight models" Style="{StaticResource SettingDesc}" Margin="0,14,0,4"/>
                                        <ItemsControl x:Name="OllamaCatalogList"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Text="A model downloads once (about the size shown) and then ? answers run fully offline. After a pull Lumo sets it as the active model if the current one isn't installed."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= ABOUT ================= -->
                        <ScrollViewer x:Name="PanelAbout" behaviors:SmoothScroll.Enabled="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Lumo" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="AboutVersion" Text="v1.3" FontSize="14" Margin="10,8,0,0"
                                                       Foreground="{DynamicResource SubtitleBrush}"/>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap"
                                                   Text="A fast, portable launcher for Windows — apps, files, calculator, web search and power tools behind one hotkey."/>
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                   Text="Command prefixes:  A/ apps · F/ files · C/ calculator · W/ web · I/ images · U/ utilities"/>
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SubtitleBrush}"
                                                   Text="Made by Najmul Islam Anik · MIT License"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="★ Star on GitHub" Style="{StaticResource AccentButton}" Click="OnOpenGitHub"/>
                                            <Button Content="Copy GitHub link" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnCopyGitHub"/>
                                        </StackPanel>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,16"/>
                                        <!-- v2.6 — Task 5.2 portable data mode -->
                                        <TextBlock Text="Data location" Style="{StaticResource SettingName}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="DataPathText" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" Text="%LOCALAPPDATA%\Lumo"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,4,0,0"
                                                   Text="Settings, shortcuts, chats and plugins live here. Put a folder named “data” next to Lumo.exe and everything (including the log) moves inside it — portable mode, perfect for USB sticks."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Open data folder" Style="{StaticResource GhostButton}" Click="OnOpenDataFolder"/>
                                            <Button Content="Replay intro tour" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnReplayTour"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AboutStatus" Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- v3.0.0-alpha.5 — storage & maintenance: Lumo's own caches
                                     and temp files, sized live, clearable one click each -->
                                <TextBlock Text="Storage &amp; maintenance" Style="{StaticResource SectionTitle}" Margin="0,22,0,0"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cache and temp files" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                           Text="Everything here is safe to clear while Lumo runs — logs are re-created, downloads can be re-fetched, and nothing user-created is ever touched."/>
                                            </StackPanel>
                                            <Button x:Name="CleanupRefreshButton" Grid.Column="1" Content="Refresh"
                                                    Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Top"
                                                    Click="OnCleanupRefresh"/>
                                        </Grid>
                                        <ItemsControl x:Name="CleanupList" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="CleanupStatus" Margin="0,10,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- v2.6 — Task 5.1 auto-update card -->
                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,22,0,0"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Once a day Lumo quietly asks GitHub Releases whether a newer build is out. Nothing downloads without your click."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="UpdatesToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                   Text="Automatic checks are on — Lumo checks about once a day."/>
                                        <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                                     Visibility="Collapsed" Background="{DynamicResource SegTrackBrush}"
                                                     Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="CheckUpdatesButton" Content="Check now" Style="{StaticResource GhostButton}" Click="OnCheckUpdates"/>
                                            <Button x:Name="DownloadUpdateButton" Content="Download update" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                                    Visibility="Collapsed" Click="OnDownloadUpdate"/>
                                            <Button x:Name="OpenStagedButton" Content="Open downloaded zip" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                                    Visibility="Collapsed" Click="OnOpenStagedUpdate"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============ footer ============ -->
                <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="24,12" CornerRadius="0,0,8,8"
                        BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource SubtitleBrush}"
                                   Text="Appearance changes apply live · press Save to keep them"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel"/>
                            <Button Content="Save" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="OnSave"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
