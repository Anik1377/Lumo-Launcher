<Window x:Class="Lumo.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumo Settings"
        Width="1200" Height="800"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        v2.0 — full-window Windows 11 style settings app.

        Solid Fluent surfaces (no acrylic): page background #202020/#F3F3F3, white/dark
        cards with hairline strokes, 4 px control geometry, Segoe UI. The window opens
        filling the work area like a real Windows 11 system app. The nav uses the Win11
        selection pill (accent bar + tinted row). No outer glow anywhere — the only
        animated accent is the launcher's rim comet.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 toggle switch (40×20, rounded track, accent when on) -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource SegTrackBrush}" BorderThickness="0"/>
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource TitleBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Setter TargetName="Dot" Property="Margin" Value="24,0,0,0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Margin"
                                                                To="24,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Margin"
                                                                To="4,0,0,0" Duration="0:0:0.14">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 nav item: rounded row, accent bar + tinted fill when selected -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,8">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch" Margin="-7,2,0,2"
                                           Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                           Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented-control segment (macOS style: joint track, elevated selection) -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,5.5">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegSelBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- option pill (border styles) — Win11 buttons are rectangles with 4 px corners -->
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" Padding="14,6.5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- buttons -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource FieldBrush}" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.0 — Win11 page title (large, semibold, sentence case) -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Margin" Value="2,0,0,14"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <!-- v2.0 — full-bleed window: no outer glow frame, no margin -->
    <Grid>
        <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Background="#FF202020"
                BorderBrush="{DynamicResource BorderLineBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.30"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ title bar (Win11: 44 px, quiet, caption buttons right) ============ -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragWindow" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lumo" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" FontSize="14"
                                   Foreground="{DynamicResource TitleBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="7,2.5"
                                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                            <TextBlock Text="ALPHA · UNSTABLE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="4" Margin="8,0,0,0" Padding="7,2.5">
                            <TextBlock x:Name="VersionText" Text="v2.0" FontSize="10.5"
                                       Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinButton" Width="46" Height="34" Click="OnMinimize"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Foreground="{DynamicResource TitleBrush}"/>
                        <Button x:Name="CloseButton" Width="46" Height="34" Click="OnClose"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Foreground="{DynamicResource TitleBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- ============ body ============ -->
                <Grid Grid.Row="1" Margin="24,8,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- sidebar (Win11 nav: monochrome glyphs on quiet rows) -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="4"
                            Padding="0,10" Margin="0,0,20,0">
                        <StackPanel>
                            <RadioButton x:Name="NavGeneral" Tag="0" IsChecked="True" Checked="OnNavChanged"
                                         Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="General" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="1" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="2" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Hotkey" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="3" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Search &amp; Index" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="4" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Shortcuts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Tag="5" Checked="OnNavChanged" Style="{StaticResource NavRadio}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TitleBrush}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="About" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- panels -->
                    <Grid Grid.Column="1">

                        <!-- ================= GENERAL ================= -->
                        <ScrollViewer x:Name="PanelGeneral" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start Lumo when Windows starts" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Adds Lumo to the per-user Run key — no admin rights needed. Applied when you press Save."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hide launcher when it loses focus" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Click anywhere else and the launcher tucks itself away."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="HideOnFocusLossToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Web search engine" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Used by W/ queries and the “search the web” row."/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                    Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="EngineGoogle" Content="Google" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                    <RadioButton x:Name="EngineBing" Content="Bing" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                    <RadioButton x:Name="EngineDdg" Content="DuckDuckGo" Style="{StaticResource SegRadio}" GroupName="Engine"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= APPEARANCE ================= -->
                        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Theme" Style="{StaticResource SettingName}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <Border Grid.Column="2" Background="{DynamicResource SegTrackBrush}" CornerRadius="9" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                    <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                    <RadioButton x:Name="ThemeAuto" Content="Auto" Style="{StaticResource SegRadio}" GroupName="Theme"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,7,0,0"
                                                   Text="Auto follows the Windows personalization colour mode and switches live."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="UI animations" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="Window spring-in, cascading results, hover transitions. Turn off for a reduced-motion, snappier feel."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderLineBrush}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Glow border effect" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}" Text="A minimal accent light that orbits the rim of the launcher window — inside the border, never outside. Changes apply live."/>
                                            </StackPanel>
                                            <ToggleButton x:Name="BorderEffectToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Border style" Style="{StaticResource SettingName}"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <RadioButton x:Name="StyleAurora" Content="Aurora" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                    <RadioButton x:Name="StyleSunset" Content="Sunset" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                    <RadioButton x:Name="StyleOcean" Content="Ocean" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                    <RadioButton x:Name="StyleEmber" Content="Ember" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                    <RadioButton x:Name="StyleMint" Content="Mint" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                    <RadioButton x:Name="StyleSolid" Content="Solid accent" Style="{StaticResource PillRadio}" GroupName="BStyle"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Speed" Style="{StaticResource SettingName}"/>
                                                <Border Grid.Column="1" Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                        Padding="3" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="SpeedFast" Content="Fast" Style="{StaticResource SegRadio}" GroupName="BSpeed"/>
                                                        <RadioButton x:Name="SpeedNormal" Content="Normal" Style="{StaticResource SegRadio}" GroupName="BSpeed"/>
                                                        <RadioButton x:Name="SpeedSlow" Content="Slow" Style="{StaticResource SegRadio}" GroupName="BSpeed"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- v2.0.1 — advanced fine-tuning -->
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid>
                                                    <TextBlock Text="Glow brightness" Style="{StaticResource SettingName}"/>
                                                    <TextBlock x:Name="GlowOpacityValue" Text="90%" HorizontalAlignment="Right"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                                <Slider x:Name="GlowOpacitySlider" Minimum="40" Maximum="100" TickFrequency="5"
                                                        IsSnapToTickEnabled="True" Margin="0,8,14,0"
                                                        Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" MinWidth="220" Margin="24,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="Rim thickness" Style="{StaticResource SettingName}"/>
                                                    <TextBlock x:Name="RimThicknessValue" Text="3 px" HorizontalAlignment="Right"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                                <Slider x:Name="RimThicknessSlider" Minimum="2" Maximum="6" TickFrequency="0.5"
                                                        IsSnapToTickEnabled="True" Margin="0,8,0,0"
                                                        Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid>
                                                    <TextBlock Text="Launcher width" Style="{StaticResource SettingName}"/>
                                                    <TextBlock x:Name="WidthValue" Text="720 px" HorizontalAlignment="Right"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                                <Slider x:Name="WidthSlider" Minimum="560" Maximum="900" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" Margin="0,8,14,0"
                                                        Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                <TextBlock Text="Corner radius" Style="{StaticResource SettingName}"/>
                                                <Border Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                        Padding="3" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="CornerRounded" Content="Win11 rounded" Style="{StaticResource SegRadio}" GroupName="Corner"/>
                                                        <RadioButton x:Name="CornerSquare" Content="Square" Style="{StaticResource SegRadio}" GroupName="Corner"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Result density" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="Compact tightens the result rows so more fit on screen."/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource SegTrackBrush}" CornerRadius="9"
                                                    Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="DensityComfortable" Content="Comfortable" Style="{StaticResource SegRadio}" GroupName="Density"/>
                                                    <RadioButton x:Name="DensityCompact" Content="Compact" Style="{StaticResource SegRadio}" GroupName="Density"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- live preview strip -->
                                        <Border Margin="0,16,0,0" CornerRadius="12" BorderThickness="1.4" Height="64"
                                                x:Name="PreviewCard" Background="{DynamicResource FieldBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="L" FontWeight="Bold" FontSize="16" Margin="16,0,10,0"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Type to search apps, files, the web…"
                                                           FontSize="13" Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="live preview" FontSize="10.5" Margin="0,0,14,0"
                                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Accent colour" Style="{StaticResource SettingName}"/>
                                        <WrapPanel x:Name="AccentRow" Margin="0,10,0,4"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Custom hex:" Style="{StaticResource SettingDesc}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="AccentHexBox" Grid.Column="1" FontSize="12.5" Padding="8,6"
                                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TitleBrush}"
                                                     BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                                     KeyDown="OnAccentHexKeyDown" LostFocus="OnAccentHexLostFocus"/>
                                            <TextBlock Grid.Column="2" Text="press Enter to apply" Style="{StaticResource SettingDesc}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= HOTKEY ================= -->
                        <ScrollViewer x:Name="PanelHotkey" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Hotkey" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Open / hide Lumo" Style="{StaticResource SettingName}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Click the box below, then press the combination you want. Requires Ctrl, Alt or Win so normal typing isn't hijacked."/>

                                        <Border x:Name="HotkeyCapture" Margin="0,12,0,0" CornerRadius="9" Padding="14,12"
                                                Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                                                BorderThickness="1" Cursor="Hand" Focusable="True"
                                                PreviewKeyDown="OnHotkeyCaptureKeyDown" MouseLeftButtonDown="OnHotkeyCaptureClick">
                                            <TextBlock x:Name="HotkeyDisplay" Text="—" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleBrush}"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Apply hotkey" Style="{StaticResource AccentButton}" Click="OnApplyHotkey"/>
                                            <Button Content="Reset to default (Alt+Space)" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnResetHotkey"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HotkeyStatus" Margin="0,10,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                   Text="Currently active hotkey is shown in the launcher status bar."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Why can't I use Win+Space?" Style="{StaticResource SettingName}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Win+Space is reserved by Windows itself for switching keyboard layouts — no application can register it. This was the cause of the v1.0 'hotkey never works' report. Pick any other combination, e.g. Alt+Space, Ctrl+Alt+Space or Win+Q. If a combo is already taken by another app, Lumo automatically walks a fallback chain and tells you which one actually registered."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= SEARCH & INDEX ================= -->
                        <ScrollViewer x:Name="PanelSearch" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Search &amp; Index" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Maximum indexed files" Style="{StaticResource SettingName}"/>
                                                <TextBlock Style="{StaticResource SettingDesc}"
                                                           Text="Upper bound of the background file index. A smaller index builds faster; a larger one finds more. Applied on the next rebuild."/>
                                            </StackPanel>
                                            <TextBlock x:Name="MaxFilesLabel" Grid.Column="1" Text="150,000" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="MaxFilesSlider" Minimum="10000" Maximum="300000" TickFrequency="10000"
                                                IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <Button Content="Rebuild index now" Style="{StaticResource GhostButton}" Margin="0,12,0,0" Click="OnRebuildIndex"/>
                                        <TextBlock x:Name="IndexStatus" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" Style="{StaticResource SettingName}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Open log folder" Style="{StaticResource GhostButton}" Click="OnOpenLog"/>
                                            <Button Content="Open settings folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenSettingsFolder"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LogPathText" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource SubtitleBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= SHORTCUTS (v1.4) ================= -->
                        <ScrollViewer x:Name="PanelShortcuts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Shortcuts &amp; Macros" Style="{StaticResource SectionTitle}"/>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Your one-tap launches" Style="{StaticResource SettingName}"/>
                                            <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                       Text="Save a URL, file, folder, a multi-step macro or a text snippet — then type  /sc name  (or  !name  for snippets) in Lumo (or just  /  to browse)."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="RecordMacroButton" Content="⏺ Record macro" Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" Click="OnRecordMacro"
                                                    ToolTip="Capture what you launch in Lumo as macro steps"/>
                                            <Button Content="＋ New shortcut" Style="{StaticResource AccentButton}"
                                                    VerticalAlignment="Center" Click="OnNewShortcut"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SAVED SHORTCUTS" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource SubtitleBrush}"/>
                                        <ItemsControl x:Name="ShortcutsList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                           Margin="0,1,8,0"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DescribeText}" FontSize="11.5" Margin="19,2,0,0"
                                                                       Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit" Style="{StaticResource GhostButton}" Padding="12,6"
                                                                    Click="OnEditShortcut"/>
                                                            <Button Content="Delete" Style="{StaticResource GhostButton}" Padding="12,6"
                                                                    Margin="8,0,0,0" Click="OnDeleteShortcut"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ShortcutsEmpty" Text="No shortcuts yet — create your first one above. A good start: a URL you open every day."
                                                   FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ================= ABOUT ================= -->
                        <ScrollViewer x:Name="PanelAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Lumo" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="AboutVersion" Text="v1.3" FontSize="14" Margin="10,8,0,0"
                                                       Foreground="{DynamicResource SubtitleBrush}"/>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap"
                                                   Text="A fast, portable launcher for Windows — apps, files, calculator, web search and power tools behind one hotkey."/>
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SubtitleBrush}" TextWrapping="Wrap"
                                                   Text="Command prefixes:  A/ apps · F/ files · C/ calculator · W/ web · I/ images · U/ utilities"/>
                                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SubtitleBrush}"
                                                   Text="Made by Najmul Islam Anik · MIT License"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="★ Star on GitHub" Style="{StaticResource AccentButton}" Click="OnOpenGitHub"/>
                                            <Button Content="Copy GitHub link" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnCopyGitHub"/>
                                        </StackPanel>
                                        <TextBlock x:Name="AboutStatus" Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============ footer ============ -->
                <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="24,12" CornerRadius="0,0,8,8"
                        BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource SubtitleBrush}"
                                   Text="Appearance changes apply live · press Save to keep them"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel"/>
                            <Button Content="Save" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="OnSave"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
