<Window x:Class="Lumo.UI.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lumo.UI"
        xmlns:behaviors="clr-namespace:Lumo.UI"
        Title="Lumo"
        Width="900" Height="640"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        v2.3.0-alpha.4 — the dedicated AI chat tab (AI/ prefix → Enter, or AI/query),
        polished to the prompt-kit grade (prompt-kit.com), rebuilt natively in WPF so
        the launcher keeps its single portable exe (no WebView2, no browser engine).

        What the polish pass changed (the "cheap" tells, fixed):
          · the card now FILLS the window — DWM rounds + shadows the real edge, the
            old 8 px transparent gutter made the shadow float detached from the card;
          · the stock WPF scrollbar (chunky arrows) is replaced by the launcher's
            slim 8 px overlay thumb;
          · the empty state is a gradient logo orb with a breathing halo, not a flat
            accent ellipse;
          · the assistant avatar is a gradient circle with a white sparkle mark
            (prompt-kit's message avatar), not a literal "?" glyph;
          · typing dots pulse on a smooth sine wave instead of stepping;
          · every message enters with a short fade + rise (Apple §1 fluid response);
          · the prompt input grows an accent focus ring, the send button is a
            gradient cap with a soft shadow and a hover-scale micro-motion;
          · the model chip carries a live status dot (green local / accent API) and
            the AI-off banner became an actionable card (opens Settings → AI).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Apple craft — slim overlay scrollbar, same as the launcher window (an 8 px
             invisible lane with a small rounded thumb). The stock WPF scrollbar would
             break the illusion instantly. -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Margin="2" CornerRadius="2"
                                                        Background="{DynamicResource SubtitleBrush}" Opacity="0.32"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Opacity" Value="0.55"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Opacity" Value="0.72"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBd" Margin="2" CornerRadius="2"
                                                                Background="{DynamicResource SubtitleBrush}" Opacity="0.32"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.72"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- v2.6.0-alpha.8 — the ChatGPT send cap: a SOLID face circle with an
             inverted glyph (white on near-black in light mode, black on white in
             dark mode), no glow — the one element that reads "primary" is enough.
             Gentle hover-scale kept (the micro-motion that separates premium from
             flat). Glyph via Tag (send ↑ / stop ■); faces come from the theme. -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Tag" Value="&#xE72A;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Cap" Fill="{DynamicResource SendButtonFaceBrush}"/>
                            <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource SendButtonGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1.07" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1.07" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="0.94" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="0.94" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cap" Property="Opacity" Value="0.30"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.6.0-alpha.3 — voice typing toggle: a quiet 30 px ghost cap that sits
             left of the send button and lights up with the accent while the mic is
             live (Tag == "listening", set from code; Content carries the glyph). -->
        <Style x:Key="MicButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Cap" Fill="Transparent"
                                     Stroke="{DynamicResource BorderLineBrush}" StrokeThickness="1"/>
                            <TextBlock x:Name="Glyph" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource SubtitleBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cap" Property="Fill" Value="{DynamicResource ChipBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="listening">
                                <Setter TargetName="Cap" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Cap" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cap" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.6.0-alpha.5 — the recording overlay's PROMINENT stop cap: a 46 px red
             disc with a soft red glow and a slow heartbeat scale while a session is
             live (Tag == "recording"). The overlay is built around this one button —
             finishing the clip must be impossible to miss. -->
        <Style x:Key="VoiceStopButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Cap" Fill="#FFE5484D">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="#FFE5484D"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="Glyph" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="recording">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1.06" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1.06" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cap" Property="Fill" Value="#FFF2564F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cap" Property="Fill" Value="#FFC0383C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cap" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.6.0-alpha.5 — ghost round cap for the overlay's secondary actions
             (pause/resume, cancel): the same quiet ring language as the mic button. -->
        <Style x:Key="VoiceRoundButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Cap" Fill="Transparent"
                                     Stroke="{DynamicResource BorderLineBrush}" StrokeThickness="1"/>
                            <TextBlock x:Name="Glyph" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                       Foreground="{DynamicResource SubtitleBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cap" Property="Fill" Value="{DynamicResource ChipBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cap" Property="Fill" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cap" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.6.0-alpha.5 — accent pill for the model setup card's primary action. -->
        <Style x:Key="VoiceAccentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="White" TextBlock.FontSize="12"
                                              TextBlock.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ghost caption buttons (New chat / minimize / close) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- close caption: WinUI red hover, the one caption button that earns colour -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.4.0-alpha.4 — minimal suggestion pill: no accent seed dot, just a
             hairline quiet pill that lifts its stroke on hover (the launcher's
             raised-card language). The pill no longer shouts.
             v2.4.0-alpha.6 — the pill text is THEME-AWARE (TitleBrush): WPF's
             default ControlText black used to leak through the template and
             turn invisible on the dark pill. Ink now flips white-on-black /
             black-on-white with the theme, and the fill got a touch more
             presence so the pills read at a glance. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="ui:PressFeedback.IsEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SelStrokeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.4.0-alpha.4 — the model chip is a ghost BUTTON now (click = model picker
             dropdown): quiet chip fill + hairline, hover lifts to the raised stroke. -->
        <Style x:Key="GhostChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SelStrokeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.6.0-alpha.8 — ChatGPT-style top picker: a BORDERLESS text button in
             the caption band (the model / persona name IS the control, the chevron
             rides along; hover just breathes a soft fill). Replaces the bordered
             ghost chip — the header reads like chatgpt.com's top bar now. -->
        <Style x:Key="TopPickerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="9,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChipBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.4.0-alpha.4 — model picker dropdown: the launcher's rounded flyout
             (opaque FieldBrush card — a chromeless popup must paint its own backdrop),
             hairline stroke, soft shadow, hover rows. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10" Background="{DynamicResource FieldBrush}"
                                BorderBrush="{DynamicResource SelStrokeBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="11,6.5" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v3.0 — hub nav rail: 40 px glyph radios; the active tab is a soft fill
             with the accent glyph, matching the quiet-rail pattern -->
        <Style x:Key="RailRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource RailRadio}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="15"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- the card fills the whole window: DWM draws rounding + shadow on the true edge
         (CornerRadius is synced to the DWM value in code — Win11 8 px, Win10 0).
         v2.4.0-alpha.4 — the border is the top-lit CardStrokeBrush (bright white over
         the top edge settling into the hairline), same material as the launcher rim. -->
    <Border x:Name="RootCard" CornerRadius="8"
            Background="{DynamicResource PanelBrush}"
            TextElement.FontFamily="/Assets/Fonts/#Inter"
            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- v3.0 — the hub nav rail -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- caption -->
                <RowDefinition Height="Auto"/>   <!-- AI-off banner -->
                <RowDefinition Height="*"/>      <!-- conversation -->
                <RowDefinition Height="Auto"/>   <!-- prompt input -->
                <RowDefinition Height="Auto"/>   <!-- hints -->
            </Grid.RowDefinitions>

            <!-- ============ caption — v2.4.0-alpha.4: quiet dark band, hairline only;
                 the model chip is now a clickable picker ============ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" x:Name="CaptionBar" Background="{DynamicResource CaptionBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="OnDragWindow">
                <Grid Height="46" Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- logo orb: gradient disc + white sparkle mark -->
                        <Grid Width="22" Height="22" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse x:Name="LogoDisc" Fill="{DynamicResource OrbBrush}"/>
                            <Path Data="M11,1.5 C11.65,6.4 15.6,10.35 20.5,11 C15.6,11.65 11.65,15.6 11,20.5 C10.35,15.6 6.4,11.65 1.5,11 C6.4,10.35 10.35,6.4 11,1.5 Z"
                                  Fill="White" Stretch="Uniform" Width="11" Height="11"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Lumo" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                        <!-- model picker → ChatGPT-style borderless text button
                             (dot shows provider liveness) -->
                        <Button x:Name="ModelChip" Style="{StaticResource TopPickerButton}" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="OnModelChipClick"
                                ToolTip="Switch model">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ModelDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Margin="0,0,7,0" Fill="#FF10B981"/>
                                <TextBlock x:Name="ModelChipText" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" &#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"
                                           Margin="6,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- v2.4.0-alpha.5 — persona chip: the system prompt that shapes
                             every reply in this chat; click = persona flyout.
                             v3.0 — the chip shows the persona's FACE, not a glyph. -->
                        <Button x:Name="PersonaChip" Style="{StaticResource TopPickerButton}" Margin="4,0,0,0"
                                VerticalAlignment="Center" Click="OnPersonaChipClick"
                                ToolTip="Persona — the system prompt shaping every reply">
                            <StackPanel Orientation="Horizontal">
                                <behaviors:PersonaFaceView x:Name="PersonaFaceGlyph" Width="17" Height="17"
                                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PersonaChipText" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" &#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"
                                           Margin="5,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- v2.4.0-alpha.5 — glyph caption buttons: history toggle, new chat (text
                             moved into the sidebar header to declutter the caption band) -->
                        <Button x:Name="HistoryButton" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Style="{StaticResource CaptionButton}" Click="OnHistoryClick" ToolTip="Chat history"/>
                        <Button x:Name="NewChatButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Style="{StaticResource CaptionButton}" Click="OnNewChat" ToolTip="New chat (Ctrl+N)"/>
                        <!-- v2.4.0-alpha.6 — fullscreen / window toggle (also F11) -->
                        <Button x:Name="FullscreenButton" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource CaptionButton}" Click="OnFullscreenClick" ToolTip="Fullscreen (F11)"/>
                        <Button x:Name="MinButton" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource CaptionButton}" Click="OnMinimize"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Style="{StaticResource CloseCaptionButton}" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ v3.0 — the hub nav rail: AI chat / App Deck / settings.
                 A quiet 54 px strip under the caption; the active tab reads by its
                 accent glyph + soft fill, never a loud highlight bar. ============ -->
            <Border Grid.Row="1" Grid.RowSpan="4" Grid.Column="0" x:Name="NavRail"
                    Background="{DynamicResource CaptionBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <Button x:Name="RailSettingsButton" Style="{StaticResource RailButton}"
                                Content="&#xE713;" Click="OnRailSettingsClick"
                                ToolTip="Open Lumo settings"/>
                    </StackPanel>
                    <StackPanel Margin="0,8">
                        <RadioButton x:Name="RailAi" Style="{StaticResource RailRadio}"
                                     Content="&#xE99A;" GroupName="RailTab" IsChecked="True"
                                     Checked="OnRailTabChanged" Unchecked="OnRailTabChanged"
                                     ToolTip="AI chat"/>
                        <RadioButton x:Name="RailDeck" Style="{StaticResource RailRadio}"
                                     Content="&#xE8A9;" GroupName="RailTab"
                                     Checked="OnRailTabChanged" Unchecked="OnRailTabChanged"
                                     ToolTip="App Deck — numpad 1–9 quick launch"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ AI-off banner (actionable card) ============ -->
            <Border x:Name="AiOffBanner" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="14,10,14,0"
                    Background="{DynamicResource WarnBrush}" CornerRadius="8"
                    BorderBrush="#3CCA5010" BorderThickness="1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TitleBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="AI is off — enable it in Settings → AI. Local Ollama needs no API key."/>
                    <Button x:Name="BannerSettingsButton" Grid.Column="2" Content="Open AI settings"
                            Style="{StaticResource CaptionButton}" FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentBrush}" Click="OnOpenAiSettings"/>
                </Grid>
            </Border>

            <!-- ============ conversation column ============ -->
            <Grid Grid.Row="2" Grid.Column="1">
                <ScrollViewer x:Name="ChatScroll" behaviors:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto"
                              Padding="28,20,28,8" ScrollChanged="OnScrollChanged">
                    <Grid MaxWidth="760" HorizontalAlignment="Center">
                        <StackPanel x:Name="MessagesHost"/>
                    </Grid>
                </ScrollViewer>

                <!-- empty state: the v3 mascot (it adopts the active persona's face
                     and color), with the quiet breathing halo behind it -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="560" TextBlock.TextAlignment="Center">
                    <Grid Width="120" Height="118" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse x:Name="OrbGlow" Width="120" Height="120" Fill="{DynamicResource GlowBrush}" Opacity="0.7"/>
                        <behaviors:MascotView x:Name="Mascot" Width="112" Height="106" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="What can I help with?" FontSize="25" FontWeight="SemiBold" Margin="0,16,0,0"
                               Foreground="{DynamicResource TitleBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptySub" FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubtitleBrush}" HorizontalAlignment="Center"/>
                    <WrapPanel x:Name="ChipHost" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============ prompt input (prompt-kit PromptInput, focus ring in code).
                 v2.6.0-alpha.5 — the border now hosts the attachment strip above the
                 prompt row (prompt-kit ImageAttachment: thumbnail + remove cap). ============ -->
            <Border Grid.Row="3" Grid.Column="1" x:Name="PromptShell" Margin="20,8,20,2" CornerRadius="24"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel x:Name="AttachHost" Grid.Row="0" Margin="15,10,15,0" Visibility="Collapsed"/>
                    <Grid Grid.Row="1" Margin="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBox x:Name="PromptBox" FontSize="14" AcceptsReturn="True"
                                 MaxHeight="132" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TitleBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center"
                                 MaxLength="4000" KeyDown="OnPromptKeyDown" TextChanged="OnPromptTextChanged"
                                 GotKeyboardFocus="OnPromptFocusChanged" LostKeyboardFocus="OnPromptFocusChanged"/>
                        <TextBlock x:Name="PromptPlaceholder" Text="Ask anything…" FontSize="14" Margin="1,0,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SubtitleBrush}" Opacity="0.6"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PromptBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- v2.6.0-alpha.3 — voice typing: mic between the prompt and send; hidden
                         entirely when disabled in Settings or the PC has no speech recognizer. -->
                    <Button x:Name="AttachButton" Grid.Column="1" Style="{StaticResource MicButton}"
                            Content="&#xE723;" VerticalAlignment="Bottom" Margin="8,0,0,4" Click="OnAttachClick"
                            ToolTip="Attach an image (vision models) — or paste one" Visibility="Collapsed"/>
                    <Button x:Name="MicButton" Grid.Column="2" Style="{StaticResource MicButton}"
                            Content="&#xE720;" VerticalAlignment="Bottom" Margin="8,0,0,4" Click="OnMicClick"
                            ToolTip="Voice input (Ctrl+M)" Visibility="Collapsed"/>
                    <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource SendButton}"
                            VerticalAlignment="Bottom" Margin="10,0,0,3" Click="OnSendClick"/>
                    <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource SendButton}" Tag="&#xE71A;"
                            VerticalAlignment="Bottom" Margin="10,0,0,3" Visibility="Collapsed" Click="OnStopClick"
                            ToolTip="Stop generating"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ v2.6.0-alpha.5 — the voice overlay: live waveform proof-of-life,
                 elapsed clock, and the one PROMINENT red stop cap. It takes the prompt
                 row's place while a voice session is live (code collapses PromptShell so
                 exactly one of the two shows). It also hosts the one-time Whisper model
                 setup card — shown BEFORE recording starts when the engine is whisper and
                 the model isn't installed yet. ============ -->
            <Border x:Name="VoiceOverlay" Grid.Row="3" Grid.Column="1" Margin="20,8,20,2" CornerRadius="24"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="14,9">
                    <!-- live recording / transcribing -->
                    <Grid x:Name="VoiceLivePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VoiceDot" Width="9" Height="9" VerticalAlignment="Center" Fill="#FFE5484D"/>
                                <TextBlock x:Name="VoiceStatusText" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" Text="Listening…"/>
                                <TextBlock x:Name="VoiceTimerText" Margin="10,0,0,0" FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center" Text="0:00"/>
                            </StackPanel>
                            <ui:VoiceWaveform x:Name="Waveform" Height="42" Margin="1,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="VoicePauseButton" Style="{StaticResource VoiceRoundButton}"
                                    Content="&#xE769;" Click="OnVoicePauseClick" ToolTip="Pause recording"/>
                            <Button x:Name="VoiceStopButton" Style="{StaticResource VoiceStopButton}"
                                    Content="&#xE71A;" Margin="10,0,0,0" Click="OnVoiceStopClick"
                                    ToolTip="Finish &amp; transcribe (Enter)"/>
                            <Button x:Name="VoiceCancelButton" Style="{StaticResource VoiceRoundButton}"
                                    Content="&#xE8BB;" Margin="10,0,0,0" Click="OnVoiceCancelClick" ToolTip="Cancel (Esc)"/>
                        </StackPanel>
                    </Grid>

                    <!-- one-time model setup card (Whisper chosen, model not installed) -->
                    <Grid x:Name="VoiceSetupPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Better speech recognition — Whisper" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="VoiceSetupDesc" Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtitleBrush}"
                                       Text="Whisper runs fully offline and is far more accurate than Windows speech — one-time download, then the mic just works."/>
                            <StackPanel x:Name="VoiceDownloadPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <ProgressBar x:Name="VoiceDownloadBar" Height="4" Minimum="0" Maximum="1"
                                             Background="{DynamicResource ChipBrush}" Foreground="{DynamicResource AccentBrush}"
                                             BorderThickness="0"/>
                                <TextBlock x:Name="VoiceDownloadText" Margin="0,5,0,0" FontSize="10.5"
                                           Foreground="{DynamicResource SubtitleBrush}" Text="Downloading…"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- v2.6.0-alpha.6 — a real mic button on the card: one tap records
                                 right now with the built-in Windows speech, no download needed. -->
                            <Button x:Name="VoiceSetupMicButton" Style="{StaticResource VoiceRoundButton}"
                                    Content="&#xE720;" Click="OnVoiceUseWindowsClick"
                                    ToolTip="Record right away with the built-in Windows speech (no download)"/>
                            <Button x:Name="VoiceDownloadButton" Style="{StaticResource VoiceAccentButton}"
                                    Margin="10,0,0,0" Click="OnVoiceDownloadClick">
                                <TextBlock Text="Download"/>
                            </Button>
                            <Button x:Name="VoiceWindowsButton" Style="{StaticResource GhostChip}" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Click="OnVoiceUseWindowsClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Use Windows speech" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- v2.6.0-alpha.6 — the card is never a trap: an always-available
                                 way back to the prompt row (Esc does the same). -->
                            <Button x:Name="VoiceSetupCancelButton" Style="{StaticResource VoiceRoundButton}"
                                    Content="&#xE8BB;" Margin="10,0,0,0" Click="OnVoiceSetupCancelClick"
                                    ToolTip="Back to the prompt (Esc)"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ hints — v2.6.0-alpha.8: the ChatGPT disclaimer line leads,
                 the keyboard captions follow quieter ============ -->
            <StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" Margin="0,7,0,10">
                <TextBlock HorizontalAlignment="Center" FontSize="10.5" Opacity="0.62"
                           Foreground="{DynamicResource SubtitleBrush}"
                           Text="Lumo AI can make mistakes — double-check important answers."/>
                <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10" Opacity="0.5"
                           Foreground="{DynamicResource SubtitleBrush}"
                           Text="&#x21B5; send&#160;&#160;&#183;&#160;&#160;&#x21E7;&#x21B5; line break&#160;&#160;&#183;&#160;&#160;Ctrl+M voice&#160;&#160;&#183;&#160;&#160;Ctrl+N new chat&#160;&#160;&#183;&#160;&#160;F11 fullscreen&#160;&#160;&#183;&#160;&#160;esc stop / hide"/>
            </StackPanel>

                        <!-- ============ v3.0 — the App Deck tab: an opaque overlay over the
                 chat content (the chat keeps its state underneath; nothing is
                 rebuilt when you switch back). Content is the AppDeckView
                 UserControl, created in the constructor. ============ -->
            <Border x:Name="DeckHost" Grid.Row="1" Grid.RowSpan="4" Grid.Column="1"
                    Background="{DynamicResource PanelBrush}" Visibility="Collapsed"/>

            <!-- ============ v2.4.0-alpha.5 — chat history slide-over (Raycast pattern):
                 a scrim + left panel that overlays the whole card, so the window keeps
                 its compact footprint and history never steals permanent space. -->
            <Grid x:Name="SidebarOverlay" Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Border x:Name="SidebarScrim" Background="#66000000" MouseLeftButtonDown="OnSidebarScrimClick"/>
                <Border x:Name="SidebarPanel" Width="252" HorizontalAlignment="Left"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- header: section caption + primary new-chat pill -->
                        <Grid Grid.Row="0" Margin="12,12,12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="HISTORY" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SubtitleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="SidebarNewChatButton" Grid.Column="1" Click="OnNewChat"
                                    Style="{StaticResource GhostChip}" ToolTip="New chat (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="New chat" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- session list (rows built in code) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,4">
                            <StackPanel x:Name="SidebarHost"/>
                        </ScrollViewer>

                        <!-- footer: quiet storage note -->
                        <TextBlock x:Name="SidebarFooter" Grid.Row="2" Margin="14,8,14,12" FontSize="10.5"
                                   Foreground="{DynamicResource SubtitleBrush}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
