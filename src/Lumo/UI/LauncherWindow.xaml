<Window x:Class="Lumo.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumo"
        Width="680"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- v1.2: the outer grid leaves room for the glow halo that bleeds out behind the card -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- glow halo: same rotating gradient as the border, blurred, sitting behind the card -->
        <Border x:Name="GlowHalo" CornerRadius="18" Margin="-6,-4" Opacity="0.42" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="24"/>
            </Border.Effect>
        </Border>

        <!-- main card -->
        <Border x:Name="Root" CornerRadius="12" BorderThickness="1.4" Background="#FF1E1F26"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RootShift" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- input row -->
            <Grid Grid.Row="0" Margin="18,14,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PrefixBadge" Grid.Column="0" Text="L" FontWeight="Bold" FontSize="18"
                           Foreground="#FF7C6CFF" Margin="0,1,12,0" VerticalAlignment="Center"/>
                <TextBox x:Name="Input" Grid.Column="1" FontSize="19" FontWeight="Medium"
                         Background="Transparent" BorderThickness="0" Foreground="#FFF2F3F7"
                         CaretBrush="#FF7C6CFF" VerticalAlignment="Center"
                         TextChanged="OnInputTextChanged" PreviewKeyDown="OnInputKeyDown"/>
            </Grid>

            <Border Grid.Row="1" Height="1" x:Name="Separator" Background="#FF2A2C38" Margin="14,0,14,0"/>

            <!-- results -->
            <ListBox x:Name="Results" Grid.Row="2" Margin="8,8,8,4" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnResultDoubleClick"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="4,2" Margin="4,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0"
                                    Background="{DynamicResource GlyphBoxBrush}">
                                <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                           Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- status bar -->
            <Grid Grid.Row="3" Margin="18,4,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource SubtitleBrush}"
                           Text="Starting…" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsGear" FontSize="11" Text="⚙ settings"
                               Foreground="{DynamicResource SubtitleBrush}" Cursor="Hand"
                               Background="Transparent" Padding="4,0"
                               MouseLeftButtonUp="OnGearClick" Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubtitleBrush}"
                               Text="↑↓ select   Enter run   Esc close"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
