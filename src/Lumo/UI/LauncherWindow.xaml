<Window x:Class="Lumo.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumo"
        Width="680"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        Activated="OnWindowActivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- kbd-style hint chip, Spotlight/Raycast flavour -->
        <Style x:Key="KbdChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource GlyphBoxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="KbdChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- outer grid leaves room for the glow halo + soft shadow that bleed out behind the card -->
    <Grid Margin="16">

        <!-- static soft shadow: static content so it is rendered once, never re-animated -->
        <Border x:Name="ShadowHost" CornerRadius="18" Margin="0,4,0,6" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.30"/>
            </Border.Effect>
            <Border Background="#44000000" CornerRadius="14" Margin="10"/>
        </Border>

        <!-- glow halo: same rotating gradient as the border, blurred, behind the card -->
        <Border x:Name="GlowHalo" CornerRadius="20" Margin="-4,-2" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <!-- main card -->
        <Border x:Name="Root" CornerRadius="16" BorderThickness="1.2" Background="#FF1C1C1E"
                TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="RootShift" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= search row ================= -->
                <Grid Grid.Row="0" Margin="20,16,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- magnifier icon: shown when no command prefix is active -->
                    <Grid x:Name="MagnifierIcon" Width="19" Height="19" VerticalAlignment="Center"
                          Margin="0,2,13,0" IsHitTestVisible="False">
                        <Ellipse Width="13" Height="13" StrokeThickness="1.7"
                                 Stroke="{DynamicResource IconBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,1.5,0,0"/>
                        <Line X1="13" Y1="13" X2="17.5" Y2="17.5"
                              Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" StrokeEndLineCap="Round"/>
                    </Grid>

                    <!-- prefix badge: shown while a command prefix (A/, F/, C/…) is active -->
                    <TextBlock x:Name="PrefixBadge" Grid.Column="0" Text="L" FontWeight="Bold" FontSize="17"
                               Foreground="{DynamicResource AccentBrush}" Margin="2,1,13,0"
                               VerticalAlignment="Center" Visibility="Collapsed"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="Input" FontSize="19" FontWeight="Normal"
                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="30"
                                 Foreground="{DynamicResource TitleBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="OnInputTextChanged" PreviewKeyDown="OnInputKeyDown"/>
                        <!-- Apple-style placeholder -->
                        <TextBlock Text="Search apps, files, the web…" FontSize="19" Margin="1,0,0,0"
                                   Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- clear button -->
                    <TextBlock x:Name="ClearButton" Grid.Column="2" Text="✕" FontSize="12.5" Padding="9,6"
                               Foreground="{DynamicResource SubtitleBrush}" Cursor="Hand"
                               VerticalAlignment="Center" MouseLeftButtonUp="OnClearClick"
                               ToolTip="Clear (Ctrl+Backspace)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="1" Height="1" x:Name="Separator" Margin="16,0,16,0" Opacity="0.9"/>

                <!-- ================= results ================= -->
                <ListBox x:Name="Results" Grid.Row="2" Margin="10,8,10,4" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultDoubleClick"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                                Padding="2" Margin="4,1">
                                            <Grid>
                                                <!-- accent-tinted overlays, faded in/out for smooth hover & selection -->
                                                <Border x:Name="HoverOverlay" CornerRadius="10"
                                                        Background="{DynamicResource HoverBrush}" Opacity="0"/>
                                                <Border x:Name="SelectedOverlay" CornerRadius="10"
                                                        Background="{DynamicResource SelectedBrush}" Opacity="0"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.22"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                        Background="{DynamicResource GlyphBoxBrush}">
                                    <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="14.5"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- kind chip (App / File / Web / Tool …) -->
                                <Border Grid.Column="2" CornerRadius="5" Padding="7,2.5" VerticalAlignment="Center"
                                        Background="{DynamicResource ChipBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KindLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource ChipTextBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ================= status bar ================= -->
                <Grid Grid.Row="3" Margin="20,4,14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                               Foreground="{DynamicResource SubtitleBrush}"
                               Text="Starting…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="&#x21B5; open"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="&#x2193;&#x2191; select"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="esc hide"/>
                        </Border>
                        <TextBlock x:Name="SettingsGear" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource SubtitleBrush}" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="7,3" ToolTip="Settings"
                                   MouseLeftButtonUp="OnGearClick">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
