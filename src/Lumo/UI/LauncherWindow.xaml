<Window x:Class="Lumo.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lumo.UI"
        Title="Lumo"
        Width="720"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        Activated="OnWindowActivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
        v1.7 "Glass" — the window IS the glass card.

        How the glassmorphism works (no AllowsTransparency!):
        · The DWM frame is extended across the whole window (WindowChrome GlassFrameThickness="-1"),
          so the window is composited by DWM and can show the acrylic backdrop behind it.
        · GlassBackdrop.cs enables the real system acrylic on Win11 22H2+ (DWMWA_SYSTEMBACKDROP_TYPE),
          with a composition-attribute acrylic fallback on Windows 10 / early Win11.
        · The Root card paints translucent colours on top of that blur (Appearance.GlassFor),
          and falls back to opaque palette colours when blur is unavailable.
        · On Windows 11 the window itself gets DWM rounded corners (DWMWCP_ROUND, 8 px) —
          the card radius below matches them exactly.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- glyph → vector icon (modern outline set, 24×24 stroke paths) -->
        <ui:GlyphIconConverter x:Key="GlyphToIcon"/>

        <!-- kbd-style hint chip, Spotlight/Raycast flavour -->
        <Style x:Key="KbdChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource GlyphBoxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="KbdChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- main glass card (DWM draws the real drop shadow + rounded corners) -->
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Background="#F01C1C1E"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootShift" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- ambient accent wash inside the top of the card (the old glow halo, now a light source) -->
            <Border x:Name="GlowHalo" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                    VerticalAlignment="Top" Height="150"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= search row ================= -->
                <Grid Grid.Row="0" Margin="20,16,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- magnifier icon: shown when no command prefix is active -->
                    <Grid x:Name="MagnifierIcon" Width="19" Height="19" VerticalAlignment="Center"
                          Margin="0,2,13,0" IsHitTestVisible="False">
                        <Ellipse Width="13" Height="13" StrokeThickness="1.7"
                                 Stroke="{DynamicResource IconBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,1.5,0,0"/>
                        <Line X1="13" Y1="13" X2="17.5" Y2="17.5"
                              Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" StrokeEndLineCap="Round"/>
                    </Grid>

                    <!-- prefix badge: shown while a command prefix (A/, F/, C/…) is active -->
                    <TextBlock x:Name="PrefixBadge" Grid.Column="0" Text="L" FontWeight="Bold" FontSize="17"
                               Foreground="{DynamicResource AccentBrush}" Margin="2,1,13,0"
                               VerticalAlignment="Center" Visibility="Collapsed"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="Input" FontSize="19" FontWeight="Normal"
                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="30"
                                 Foreground="{DynamicResource TitleBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 TextChanged="OnInputTextChanged" PreviewKeyDown="OnInputKeyDown"/>
                        <!-- Apple-style placeholder (Raycast wording, v1.6) -->
                        <TextBlock Text="Search apps and commands…" FontSize="19" Margin="1,0,0,0"
                                   Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- clear button — v1.7 vector cross (also fixed: now actually appears when text is present) -->
                    <ContentControl x:Name="ClearButton" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center"
                                    Focusable="False" Cursor="Hand" MouseLeftButtonUp="OnClearClick"
                                    ToolTip="Clear (Ctrl+Backspace)">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.Template>
                            <ControlTemplate TargetType="ContentControl">
                                <Grid Background="Transparent">
                                    <Path x:Name="ClearGlyph" Data="{x:Static ui:VectorIcons.CloseIcon}"
                                          Stroke="{DynamicResource SubtitleBrush}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="11" Height="11" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ClearGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ContentControl.Template>
                    </ContentControl>
                </Grid>

                <Border Grid.Row="1" Height="1" x:Name="Separator" Margin="16,0,16,0" Opacity="0.9"/>

                <!-- ================= results ================= -->
                <ListBox x:Name="Results" Grid.Row="2" Margin="10,8,10,4" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultDoubleClick"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                                Padding="2" Margin="4,1">
                                            <Grid>
                                                <!-- accent-tinted overlays, faded in/out for smooth hover & selection -->
                                                <Border x:Name="HoverOverlay" CornerRadius="10"
                                                        Background="{DynamicResource HoverBrush}" Opacity="0"/>
                                                <Border x:Name="SelectedOverlay" CornerRadius="10"
                                                        Background="{DynamicResource SelectedBrush}" Opacity="0"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.22"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="GlyphBox" Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                        Background="{DynamicResource GlyphBoxBrush}">
                                    <Grid>
                                        <!-- real shell icon (app logo / file type); v1.7 vector icon when none -->
                                        <Image Source="{Binding Icon}" Width="26" Height="26" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path x:Name="KindIcon" Data="{Binding Glyph, Converter={StaticResource GlyphToIcon}}"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.1"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="RowText" Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- kind chip (App / File / Web / Tool …) -->
                                <Border Grid.Column="2" CornerRadius="5" Padding="7,2.5" VerticalAlignment="Center"
                                        Background="{DynamicResource ChipBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KindLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource ChipTextBrush}"/>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- v1.6 — Raycast-style section headers: no tile, no chip,
                                     small caps look with extra breathing room above -->
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter TargetName="GlyphBox" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TitleText" Property="FontSize" Value="11"/>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
                                    <Setter TargetName="RowText" Property="Margin" Value="11,9,8,2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ================= status bar (Raycast footer) ================= -->
                <Border Grid.Row="3" Height="1" VerticalAlignment="Top" Margin="16,0,16,0"
                        Background="{DynamicResource BorderLineBrush}" Opacity="0.55"/>
                <Grid Grid.Row="3" Margin="20,10,14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                               Foreground="{DynamicResource SubtitleBrush}"
                               Text="Starting…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="&#x21B5; open"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="&#x2193;&#x2191; select"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="esc hide"/>
                        </Border>
                        <!-- v1.7 — vector gear (was a Segoe MDL2 glyph) -->
                        <ContentControl x:Name="SettingsGear" Width="26" Height="24" Focusable="False" Cursor="Hand"
                                        VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Settings"
                                        MouseLeftButtonUp="OnGearClick">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Grid Background="Transparent">
                                        <Path x:Name="GearGlyph" Data="{x:Static ui:VectorIcons.GearIcon}"
                                              Stroke="{DynamicResource SubtitleBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="GearGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
