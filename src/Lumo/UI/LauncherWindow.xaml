<Window x:Class="Lumo.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lumo.UI"
        Title="Lumo"
        Width="720"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Deactivated="OnDeactivated"
        Activated="OnWindowActivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
        v2.4 "Raycast" — the command-palette structure, natively in WPF.

        · The card paints the Raycast surface ladder (Appearance.PaletteFor):
          dark canvas #0F0F11 / light #FAFAFB, one elevation step up for fields
          and tiles, hairline #26262B strokes, quiet neutral selection.
        · v2.4.0-alpha.3 — reference round: the ladder is NEUTRAL zinc charcoal
          (no blue bias); the active row is a bordered raised card (1 px SelStroke
          outline over the fill); footer keycaps are pills with the "open" chip
          promoted to primary; a soft ambient light pools under the top edge;
          the rim ring and preview pane wear a top-lit gradient stroke
          (bright white at the top, hairline at the bottom).
        · Typography is embedded Inter (OFL) — Regular / Medium / SemiBold / Bold,
          name tables flattened so FontWeight picks the exact face.
        · The search row is flush with the card top (no boxed field — the input IS
          the header, like Raycast/Spotlight), followed by a full-bleed hairline.
        · The window keeps WindowChrome GlassFrameThickness="-1" so DWM still composites
          the drop shadow, and DWMWCP_ROUND supplies the native rounded corners
          (Windows 10 falls back to square corners set in code).
        · The only glow is the rim comet (z.ai-style): two soft light blobs orbit
          the TRUE window perimeter on a path animation, clipped to the window — the
          light only ever exists INSIDE the rim, never bleeding outside.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- glyph → vector icon (modern outline set, 24×24 stroke paths) -->
        <ui:GlyphIconConverter x:Key="GlyphToIcon"/>
        <ui:UpperTextConverter x:Key="Upper"/>

        <!-- kbd-style hint chip — v2.4.0-alpha.3 pill (reference round): the keycap
             grew from a 4 px box to a full pill with hairline stroke, matching the
             chip language of the reference material. DESIGN.md §kbd heritage:
             11px/500 text, generous horizontal padding, min-width 24.
             The PRIMARY variant (↵ open) is promoted: tile fill + SelStroke outline
             + full-ink label — one bright anchor in the footer, the way the
             reference material singles out its primary pill. -->
        <Style x:Key="KbdChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="KbdChipBorderPrimary" TargetType="Border" BasedOn="{StaticResource KbdChipBorder}">
            <Setter Property="Background" Value="{DynamicResource GlyphBoxBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelStrokeBrush}"/>
        </Style>
        <Style x:Key="KbdChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KbdChipTextPrimary" TargetType="TextBlock" BasedOn="{StaticResource KbdChipText}">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Apple craft — slim overlay scrollbar (Spotlight/Raycast): an 8 px invisible
             lane with a small rounded thumb that quietly deepens on hover. The stock
             WPF scrollbar (chunky square arrows) breaks the material illusion. -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Margin="2" CornerRadius="2"
                                                        Background="{DynamicResource SubtitleBrush}" Opacity="0.32"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Opacity" Value="0.55"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Opacity" Value="0.72"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBd" Margin="2" CornerRadius="2"
                                                                Background="{DynamicResource SubtitleBrush}" Opacity="0.32"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.72"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- v2.2 — row context menu (Win11 flyout look: rounded card, hairline stroke,
         soft shadow, hover row). Only plain click items are used, so a simple
         template pair is enough — no submenus / checkables needed.
         v2.2.0-alpha.3 — the card fill MUST be an OPAQUE brush (FieldBrush): the
         menu is a chromeless popup, an unpainted card shows the screen through it. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="5" Padding="11,6.5" Background="Transparent">
                        <!-- v2.2.0-alpha.2 — second column renders InputGestureText (e.g. "Enter") -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       FontSize="11" Margin="22,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtitleBrush}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Window.Resources>

    <!-- main card (DWM draws the real drop shadow + rounded corners);
         the hairline ring lives on RimLine, Root itself has no border -->
    <Border x:Name="Root" CornerRadius="8" BorderThickness="0" Background="#FF0E0F12"
            TextElement.FontFamily="/Assets/Fonts/#Inter"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootShift" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- ============================================================
                 v2.0.1 rim comet (z.ai chat-box style), layers bottom → top:
                   RimLine  — static hairline ring; always present for definition
                   GlowClip — the orbiting light; CLIPPED to the rounded window
                              rect in code so the blobs can only glow INSIDE
                   GlowCover— opaque surface patch inset by the rim thickness;
                              hides everything of the blobs but the outer band
                 The content grid below paints over the rest. No outer bleed,
                 no halo, no spinning gradient — just light chasing the rim.
            ============================================================== -->
            <Border x:Name="RimLine" CornerRadius="8" BorderThickness="1" IsHitTestVisible="False"/>
            <Border x:Name="GlowClip" CornerRadius="8" IsHitTestVisible="False" Opacity="0">
                <Grid>
                    <!-- head: bright core; negative margins put each blob's CENTRE at (0,0),
                         so the path animation just targets the perimeter coordinates -->
                    <Ellipse x:Name="GlowHead" Width="300" Height="300"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="GlowHeadPos" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- tail: larger + fainter, lagging behind the head (BeginTime set in code) -->
                    <Ellipse x:Name="GlowTail" Width="460" Height="460"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-230,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="GlowTailPos" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>
            <Border x:Name="GlowCover" CornerRadius="5" Margin="3" IsHitTestVisible="False"/>

            <!-- v2.4.0-alpha.3 — ambient sheen: a soft, static pool of light just under
                 the top edge (the reference material's glow). Clipped by the window clip
                 like the comet; dark mode only (opacity set in ApplyTheme). -->
            <Border x:Name="AmbientLight" Height="150" VerticalAlignment="Top" Margin="60,-75,60,0"
                    IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#12FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.45"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Apple craft — the light-catch: a 1 px bright edge along the top of the
                 card, like light grazing the top of a material surface. Clipped to the
                 window's rounded rect in code so it can never paint the corner cutouts. -->
            <Grid x:Name="TopLightHost" IsHitTestVisible="False">
                <Border x:Name="TopLight" Height="1" VerticalAlignment="Top" Opacity="0.85"/>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= search row (Raycast: the input IS the header —
                     flush with the card top, no boxed field, 54 px band) ================= -->
                <Grid Grid.Row="0" x:Name="SearchField" Background="Transparent" SnapsToDevicePixels="True">
                    <Grid Margin="18,11,14,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- magnifier icon: shown when no command prefix is active -->
                        <Grid x:Name="MagnifierIcon" Width="18" Height="18" VerticalAlignment="Center"
                              Margin="0,2,13,0" IsHitTestVisible="False">
                            <Ellipse Width="12" Height="12" StrokeThickness="1.7"
                                     Stroke="{DynamicResource IconBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,1.5,0,0"/>
                            <Line X1="12" Y1="12" X2="16.4" Y2="16.4"
                                  Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7" StrokeEndLineCap="Round"/>
                        </Grid>

                        <!-- prefix badge: shown while a command prefix (A/, F/, C/…) is active -->
                        <TextBlock x:Name="PrefixBadge" Grid.Column="0" Text="L" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" Margin="1,1,13,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="Input" FontSize="16" FontWeight="Normal"
                                     Background="Transparent" BorderThickness="0" Padding="0" MinHeight="32"
                                     Foreground="{DynamicResource TitleBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     TextChanged="OnInputTextChanged" PreviewKeyDown="OnInputKeyDown"
                                     GotKeyboardFocus="OnInputFocusChanged" LostKeyboardFocus="OnInputFocusChanged"/>
                            <!-- placeholder (Raycast tone-of-voice: lowercase, quiet) -->
                            <TextBlock Text="Search apps, files and commands…" FontSize="16" Margin="1,0,0,0"
                                       Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                            <!-- clear button — v1.7 vector cross (also fixed: now actually appears when text is present) -->
                        <ContentControl x:Name="ClearButton" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center"
                                            Focusable="False" Cursor="Hand" MouseLeftButtonUp="OnClearClick"
                                            ui:PressFeedback.IsEnabled="True"
                                            ToolTip="Clear (Ctrl+Backspace)">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Grid Background="Transparent">
                                            <Path x:Name="ClearGlyph" Data="{x:Static ui:VectorIcons.CloseIcon}"
                                                  Stroke="{DynamicResource SubtitleBrush}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="10" Height="10" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                    </Grid>
                </Grid>

                <!-- full-bleed hairline under the search row — Raycast's header rule -->
                <Border Grid.Row="1" Height="1" x:Name="Separator" Margin="0" Opacity="1"/>

                <!-- ================= results ================= -->
                <ListBox x:Name="Results" Grid.Row="2" Margin="8,6,8,4" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultDoubleClick"
                         SelectionChanged="OnResultsSelectionChanged"
                         MouseRightButtonDown="OnResultsRightDown"
                         ContextMenuOpening="OnResultsContextMenuOpening"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- Apple §1 — respond on pointer-DOWN: instant 98.5 % dip -->
                            <Setter Property="ui:PressFeedback.IsEnabled" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                Padding="0" Margin="5,1">
                                            <Grid>
                                                <!-- neutral hover / quiet selection overlays (Raycast active row) -->
                                                <Border x:Name="HoverOverlay" CornerRadius="8"
                                                        Background="{DynamicResource HoverBrush}" Opacity="0"/>
                                                <Border x:Name="SelectedOverlay" CornerRadius="8"
                                                        Background="{DynamicResource SelectedBrush}" Opacity="0"/>
                                                <!-- v2.4.0-alpha.3 — bordered raised card: a 1 px outline
                                                     around the active row lifts it off the canvas
                                                     (the reference material's selected-card cue).
                                                     Shares the selection storyboard below. -->
                                                <Border x:Name="SelStroke" CornerRadius="8" BorderThickness="1"
                                                        BorderBrush="{DynamicResource SelStrokeBrush}" Opacity="0"/>
                                                <!-- v2.0.1 — selection pill: 3 px accent punctuation on the left edge -->
                                                <Border x:Name="SelPill" Width="3" CornerRadius="1.5"
                                                        Background="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Left" Margin="0,9,0,9" Opacity="0"/>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetName="SelStroke"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetName="SelPill"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.22"/>
                                                            <DoubleAnimation Storyboard.TargetName="SelStroke"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                            <DoubleAnimation Storyboard.TargetName="SelPill"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource ResultRowPad}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="GlyphBox" Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                        Background="{DynamicResource GlyphBoxBrush}">
                                    <Grid>
                                        <!-- real shell icon (app logo / file type); v1.7 vector icon when none -->
                                        <Image Source="{Binding Icon}" Width="23" Height="23" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path x:Name="KindIcon" Data="{Binding Glyph, Converter={StaticResource GlyphToIcon}}"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="RowText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- v2.2.0-alpha.2 — pin star + kind chip share the trailing edge:
                                     ★ filled accent when pinned (always visible so a pinned row
                                     can be unpinned from any view), ☆ on hover for pinnable rows.
                                     Click is handled by OnPinStarDown — no menu needed. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="PinStar" Text="☆" FontSize="13" Margin="0,1,7,0"
                                               VerticalAlignment="Center" Cursor="Hand"
                                               MouseLeftButtonDown="OnPinStarDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                            <Condition Binding="{Binding CanPin}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="★"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- kind chip (App / File / Web / Tool …) — pill radius reads
                                         softer than the old 4 px box (v2.3.0-alpha.4) -->
                                    <Border CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                            Background="{DynamicResource ChipBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding KindLabel}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource ChipTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- v2.4.0-alpha.2 — Raycast's signature: the ACTIVE row's title
                                     takes the accent (DESIGN.md: "accent ONLY for the active row
                                     title and the caret"). Declared BEFORE the header trigger so
                                     section headers keep their muted caption even if selected. -->
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <!-- v1.6 — Raycast-style section headers: no tile, no chip,
                                     small muted UPPERCASE caption with extra breathing room above
                                     (v2.4.0-alpha.2: 11px SemiBold + uppercase per DESIGN.md §4) -->
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter TargetName="GlyphBox" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TitleText" Property="FontSize" Value="11"/>
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
                                    <Setter TargetName="TitleText" Property="Text" Value="{Binding Title, Converter={StaticResource Upper}}"/>
                                    <Setter TargetName="RowText" Property="Margin" Value="14,10,10,3"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ================= preview pane (v2.2 — Tab toggles; Esc closes)
                     v2.4.0-alpha.3 — top-lit gradient stroke (bright white over the
                     top edge, hairline below), matching the rim material -->
                <Border x:Name="PreviewPane" Grid.Row="3" Margin="10,2,10,2" CornerRadius="8"
                        Background="{DynamicResource GlyphBoxBrush}" BorderBrush="{DynamicResource PreviewStrokeBrush}"
                        BorderThickness="1" Visibility="Collapsed" Focusable="False">
                    <Grid MaxHeight="200" Margin="12,8,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewTitle" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewMeta" Grid.Column="1" FontSize="10.5" Margin="12,1,0,0"
                                       Foreground="{DynamicResource SubtitleBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <TextBlock x:Name="PreviewText" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                           FontSize="11.5" Foreground="{DynamicResource SubtitleBrush}"
                                           TextWrapping="Wrap" Text="" Visibility="Collapsed"/>
                                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="175"
                                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ================= status bar (Raycast footer) ================= -->
                <Border Grid.Row="4" Height="1" VerticalAlignment="Top" Margin="18,0,18,0"
                        x:Name="FooterRule" Opacity="0.55"/>
                <Grid Grid.Row="4" Margin="18,9,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11.5"
                               Foreground="{DynamicResource SubtitleBrush}"
                               Text="Starting…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- v2.4.0-alpha.3 — the PRIMARY chip: ↵ open is the one bright
                             anchor in the footer (tile fill, SelStroke outline, full-ink
                             label); the rest stay quiet pills -->
                        <Border Style="{StaticResource KbdChipBorderPrimary}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipTextPrimary}" Text="&#x21B5; open"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="&#x2193;&#x2191; select"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,5,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="tab preview"/>
                        </Border>
                        <Border Style="{StaticResource KbdChipBorder}" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource KbdChipText}" Text="esc hide"/>
                        </Border>
                        <!-- v1.7 — vector gear (was a Segoe MDL2 glyph) -->
                        <ContentControl x:Name="SettingsGear" Width="26" Height="24" Focusable="False" Cursor="Hand"
                                        VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Settings"
                                        ui:PressFeedback.IsEnabled="True"
                                        MouseLeftButtonUp="OnGearClick">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Grid Background="Transparent">
                                        <Path x:Name="GearGlyph" Data="{x:Static ui:VectorIcons.GearIcon}"
                                              Stroke="{DynamicResource SubtitleBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="GearGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
