<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lumo</AssemblyName>
    <RootNamespace>Lumo</RootNamespace>
    <Version>2.4.0-alpha.6</Version>
    <InformationalVersion>Lumo 2.4.0-alpha.6 (ALPHA — unstable build)</InformationalVersion>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- ResultItem.cs guards its one WPF-typed member (Icon) with LUMO_WPF so the
         Phase 0 pure test target (net8.0, no WPF) can compile the row model too. -->
    <DefineConstants Condition="'$(UseWPF)' == 'true'">$(DefineConstants);LUMO_WPF</DefineConstants>
  </PropertyGroup>

  <!-- v2.4 — Inter (OFL) embedded as WPF resources: the Raycast-grade type system.
       Name tables are flattened so all four weights resolve under one "Inter"
       family; FontWeight picks the exact face via OS/2 weight class. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Inter-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Inter-Bold.ttf" />
  </ItemGroup>

  <!-- UseWindowsForms injects global System.Drawing / System.Windows.Forms usings which
       collide with WPF types (Brush, Color, Appearance, KeyEventArgs, ...). We only need
       WinForms for the NotifyIcon tray icon, and TrayController imports it explicitly. -->
  <!-- Phase 0 — the test harness exercises internal seams (Settings.ApplyJson). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Lumo.Tests" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
