<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 0 (DEV_PLAN) — regression harness for the pure core.

       Two targets:
       · net8.0           — compile-includes Lumo's PURE source files (Fuzzy, Calculator,
                            UnitConverter, WebProviders, UsageStore, Settings, …) so the
                            suite runs on ANY OS (Linux dev boxes included).
       · net8.0-windows   — ProjectReference to the real Lumo assembly (WPF types resolve);
                            this is the target CI (windows-latest) runs. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Include="../Lumo/Core/Fuzzy.cs" Link="Core/Fuzzy.cs" />
    <Compile Include="../Lumo/Core/Calculator.cs" Link="Core/Calculator.cs" />
    <Compile Include="../Lumo/Core/UnitConverter.cs" Link="Core/UnitConverter.cs" />
    <Compile Include="../Lumo/Core/WebProviders.cs" Link="Core/WebProviders.cs" />
    <Compile Include="../Lumo/Core/AppPaths.cs" Link="Core/AppPaths.cs" />
    <Compile Include="../Lumo/Core/SystemTheme.cs" Link="Core/SystemTheme.cs" />
    <!-- v2.2.0-alpha.2 — ResultItem/ResultKind live in their own WPF-free file
         (Icon is #if NETWINDOWS), so the pin/menu policy is testable anywhere -->
    <Compile Include="../Lumo/Core/ResultItem.cs" Link="Core/ResultItem.cs" />
    <Compile Include="../Lumo/Core/RowActions.cs" Link="Core/RowActions.cs" />
    <!-- v2.3 (Phase 3) — AI provider layer, bookmark parser, snippet expander -->
    <Compile Include="../Lumo/Core/AiProviders.cs" Link="Core/AiProviders.cs" />
    <Compile Include="../Lumo/Core/Bookmarks.cs" Link="Core/Bookmarks.cs" />
    <Compile Include="../Lumo/Core/SnippetExpander.cs" Link="Core/SnippetExpander.cs" />
    <Compile Include="../Lumo/Core/MarkdownLite.cs" Link="Core/MarkdownLite.cs" />
    <Compile Include="../Lumo/Services/UsageStore.cs" Link="Services/UsageStore.cs" />
    <Compile Include="../Lumo/Services/Favourites.cs" Link="Services/Favourites.cs" />
    <Compile Include="../Lumo/Services/DiagnosticLogger.cs" Link="Services/DiagnosticLogger.cs" />
    <Compile Include="../Lumo/Services/Settings.cs" Link="Services/Settings.cs" />
    <Compile Include="../Lumo/Services/ExchangeRateService.cs" Link="Services/ExchangeRateService.cs" />
    <!-- v2.3.0-alpha.2 — one-click Ollama setup: pull-line/tags parsers, catalog, endpoint guard -->
    <Compile Include="../Lumo/Services/OllamaManager.cs" Link="Services/OllamaManager.cs" />
    <!-- v2.4.0-alpha.5 — AI chat history: session store + persona registry -->
    <Compile Include="../Lumo/Core/ChatPersonas.cs" Link="Core/ChatPersonas.cs" />
    <Compile Include="../Lumo/Services/ChatStore.cs" Link="Services/ChatStore.cs" />
    <!-- v2.4.0-alpha.6 — user-defined personas store -->
    <Compile Include="../Lumo/Services/PersonaStore.cs" Link="Services/PersonaStore.cs" />
    <!-- v2.4.0-alpha.7 — display-version parser -->
    <Compile Include="../Lumo/Core/AppVersion.cs" Link="Core/AppVersion.cs" />
    <!-- v2.5 (Phase 4) — PrefixRouter, JSON plugins, hotkey parsing -->
    <Compile Include="../Lumo/Core/PrefixRouter.cs" Link="Core/PrefixRouter.cs" />
    <Compile Include="../Lumo/Core/Plugins.cs" Link="Core/Plugins.cs" />
    <Compile Include="../Lumo/Services/PluginStore.cs" Link="Services/PluginStore.cs" />
    <!-- v2.6 (Phase 5) — release-version comparison, GitHub payload picker, update policy, portable roots -->
    <Compile Include="../Lumo/Core/UpdateCheck.cs" Link="Core/UpdateCheck.cs" />
    <Compile Include="../Lumo/Services/UpdateService.cs" Link="Services/UpdateService.cs" />
    <!-- v2.6.0-alpha.2 — first-party plugin catalog (parse/state) + the install disk path -->
    <Compile Include="../Lumo/Core/FirstParty.cs" Link="Core/FirstParty.cs" />
    <Compile Include="../Lumo/Services/FirstPartyStore.cs" Link="Services/FirstPartyStore.cs" />
    <Compile Include="../Lumo/Native/NativeMethods.cs" Link="Native/NativeMethods.cs" />
    <Compile Include="../Lumo/Services/HotkeyService.cs" Link="Services/HotkeyService.cs" />
    <Compile Include="../Lumo/Services/Shortcuts.cs" Link="Services/Shortcuts.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\Lumo\Lumo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
